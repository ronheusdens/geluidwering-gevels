REM =============================================================================
REM Acoustics P0 — shared building API + service login (DDL 0.2.0)
REM OOP: PostgreSQLDatabase for connection lifecycle (API_Bootstrap)
REM Invoke: API_Bootstrap, API_Login, API_ValidateSession, API_Logout,
REM         API_RequestAccess, API_ChangePassword,
REM         API_GetCustomerProfile, API_SaveCustomerProfile,
REM         API_ListBuildings, API_SaveBuildingEntry, API_OpenBuilding, API_DeleteProject,
REM         API_ListProjectDocuments, API_UploadDrawingChunk, API_DeleteDrawing,
REM         API_CustomerSubmitDrawings,
REM         API_EngineerListReviewQueue, API_EngineerGetProject, API_ReviewDrawings,
REM         API_ListDrawingRegions, API_SaveDrawingRegion, API_DeleteDrawingRegion,
REM         API_ListFloormapSections, API_SaveFloormapScale,
REM         API_AdminListCustomers, API_AdminListCustomerProjects, API_AdminUpdateProjectStatus,
REM         API_AdminListMaterials, API_AdminGetMaterial, API_AdminSaveMaterial, API_AdminDeleteMaterial,
REM         GA model (DDL 0.2.16): API_ListVariants, API_SaveVariant, API_DeleteVariant,
REM         API_ListVerblijfsgebieden, API_CreateVerblijfsgebied, API_SaveVerblijfsgebied, API_DeleteVerblijfsgebied,
REM         API_ListVerblijfsruimten, API_AddVerblijfsruimte, API_SaveVerblijfsruimte, API_DeleteVerblijfsruimte,
REM         API_ListVlakken, API_SaveVlak, API_DeleteVlak,
REM         API_ListVlakElementen, API_SaveVlakElement, API_DeleteVlakElement,
REM         API_ListLinkedSubsections
REM Note: nested user PROCEDURE calls from API_* are supported (root_program + retained lookup).
REM =============================================================================

INCLUDE "lib/database/postgresql_database.basicpp"
INCLUDE "fixtures/app-gevelwering/ga_model_api.basicpp"

DIM SHARED g_db AS PostgreSQLDatabase
DIM SHARED g_bootstrapped%
DIM SHARED g_conn%
DIM SHARED g_auth_user_id$
DIM SHARED g_auth_token$

PROCEDURE API_Bootstrap() AS STRING
    DIM conn$
    IF g_bootstrapped% <> 0 AND g_conn% > 0 THEN
        IF POSTGRES_IS_CONNECTED(g_conn%) <> 0 THEN
            RETURN "OK"
        END IF
    END IF

    conn$ = ENV$("BPP_PG_CONN")
    IF conn$ = "" THEN
        conn$ = "/tmp:5432:app_gevelwering:ronheusdens:"
    END IF

    g_db = NEW PostgreSQLDatabase(conn$)
    IF g_db IS NULL THEN
        RETURN "ERROR: failed to create PostgreSQLDatabase"
    END IF
    IF g_db.Connect() <> 0 THEN
        RETURN "ERROR: " + g_db.GetLastError()
    END IF

    g_conn% = POSTGRES_CREATE(conn$)
    IF g_conn% <= 0 THEN
        RETURN "ERROR: POSTGRES_CREATE failed for " + conn$
    END IF

    g_bootstrapped% = 1
    g_auth_user_id$ = ""
    g_auth_token$ = ""
    RETURN "OK"
END PROCEDURE

PROCEDURE API_Login(username$, password$) AS STRING
    DIM sql$, rid%, user_id$, display$, token$, out$
    DIM u$, p$, email$, must_chg$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF username$ = "" OR password$ = "" THEN
        RETURN "ERROR: username and password are required"
    END IF

    u$ = SUBSTITUTE$(username$, "'", "''")
    p$ = SUBSTITUTE$(password$, "'", "''")

    sql$ = "SELECT id::text AS user_id, COALESCE(display_name, '') AS display_name, " + _
        "COALESCE(email, '') AS email, must_change_password::text AS must_change_password " + _
        "FROM app_gevelwering.service_user " + _
        "WHERE username = '" + u$ + "' AND is_active = true " + _
        "AND password_hash = crypt('" + p$ + "', password_hash)"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: invalid username or password"
    END IF
    user_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "user_id")
    display$ = POSTGRES_GET_BY_NAME$(rid%, 0, "display_name")
    email$ = POSTGRES_GET_BY_NAME$(rid%, 0, "email")
    must_chg$ = POSTGRES_GET_BY_NAME$(rid%, 0, "must_change_password")

    sql$ = "INSERT INTO app_gevelwering.login_session (user_id, token, expires_at) VALUES (" + _
        "'" + user_id$ + "'::uuid, encode(gen_random_bytes(24), 'hex'), now() + interval '12 hours') " + _
        "RETURNING token"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: failed to create login session: " + POSTGRES_GET_ERROR$(g_conn%)
    END IF
    token$ = POSTGRES_GET_BY_NAME$(rid%, 0, "token")

    g_auth_user_id$ = user_id$
    g_auth_token$ = token$

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true,"
    out$ = out$ + CHR$(34) + "token" + CHR$(34) + ":" + CHR$(34) + token$ + CHR$(34) + ","
    out$ = out$ + CHR$(34) + "user_id" + CHR$(34) + ":" + CHR$(34) + user_id$ + CHR$(34) + ","
    out$ = out$ + CHR$(34) + "username" + CHR$(34) + ":" + CHR$(34) + u$ + CHR$(34) + ","
    out$ = out$ + CHR$(34) + "display_name" + CHR$(34) + ":" + CHR$(34) + display$ + CHR$(34) + ","
    out$ = out$ + CHR$(34) + "email" + CHR$(34) + ":" + CHR$(34) + email$ + CHR$(34) + ","
    IF must_chg$ = "t" OR must_chg$ = "true" OR must_chg$ = "1" THEN
        out$ = out$ + CHR$(34) + "must_change_password" + CHR$(34) + ":true"
    ELSE
        out$ = out$ + CHR$(34) + "must_change_password" + CHR$(34) + ":false"
    END IF
    out$ = out$ + "}"
    RETURN out$
END PROCEDURE

PROCEDURE API_ValidateSession(token$) AS STRING
    DIM sql$, rid%, user_id$, username$, display$, t$, out$
    DIM email$, must_chg$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF token$ = "" THEN
        RETURN "ERROR: token is required"
    END IF

    t$ = SUBSTITUTE$(token$, "'", "''")
    sql$ = "SELECT u.id::text AS user_id, u.username, COALESCE(u.display_name, '') AS display_name, " + _
        "COALESCE(u.email, '') AS email, u.must_change_password::text AS must_change_password " + _
        "FROM app_gevelwering.login_session s " + _
        "JOIN app_gevelwering.service_user u ON u.id = s.user_id " + _
        "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL " + _
        "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        g_auth_user_id$ = ""
        g_auth_token$ = ""
        RETURN "ERROR: session invalid or expired"
    END IF

    user_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "user_id")
    username$ = POSTGRES_GET_BY_NAME$(rid%, 0, "username")
    display$ = POSTGRES_GET_BY_NAME$(rid%, 0, "display_name")
    email$ = POSTGRES_GET_BY_NAME$(rid%, 0, "email")
    must_chg$ = POSTGRES_GET_BY_NAME$(rid%, 0, "must_change_password")
    g_auth_user_id$ = user_id$
    g_auth_token$ = token$

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true,"
    out$ = out$ + CHR$(34) + "token" + CHR$(34) + ":" + CHR$(34) + token$ + CHR$(34) + ","
    out$ = out$ + CHR$(34) + "user_id" + CHR$(34) + ":" + CHR$(34) + user_id$ + CHR$(34) + ","
    out$ = out$ + CHR$(34) + "username" + CHR$(34) + ":" + CHR$(34) + username$ + CHR$(34) + ","
    out$ = out$ + CHR$(34) + "display_name" + CHR$(34) + ":" + CHR$(34) + display$ + CHR$(34) + ","
    out$ = out$ + CHR$(34) + "email" + CHR$(34) + ":" + CHR$(34) + email$ + CHR$(34) + ","
    IF must_chg$ = "t" OR must_chg$ = "true" OR must_chg$ = "1" THEN
        out$ = out$ + CHR$(34) + "must_change_password" + CHR$(34) + ":true"
    ELSE
        out$ = out$ + CHR$(34) + "must_change_password" + CHR$(34) + ":false"
    END IF
    out$ = out$ + "}"
    RETURN out$
END PROCEDURE

PROCEDURE API_Logout(token$) AS STRING
    DIM sql$, t$, rid%

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF token$ = "" THEN
        RETURN "ERROR: token is required"
    END IF

    t$ = SUBSTITUTE$(token$, "'", "''")
    sql$ = "UPDATE app_gevelwering.login_session SET revoked_at = now() "
    sql$ = sql$ + "WHERE token = '" + t$ + "' AND revoked_at IS NULL"
    rid% = POSTGRES_QUERY(g_conn%, sql$)

    g_auth_user_id$ = ""
    g_auth_token$ = ""
    RETURN "OK"
END PROCEDURE

PROCEDURE API_RequestAccess(username$, email$, display_name$) AS STRING
    DIM sql$, rid%, u$, e$, d$, temp_pw$, user_id$, out$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF username$ = "" OR email$ = "" THEN
        RETURN "ERROR: username and email are required"
    END IF

    u$ = SUBSTITUTE$(username$, "'", "''")
    e$ = SUBSTITUTE$(email$, "'", "''")
    d$ = SUBSTITUTE$(display_name$, "'", "''")
    IF d$ = "" THEN
        d$ = u$
    END IF

    sql$ = "SELECT 1 FROM app_gevelwering.service_user WHERE username = '" + u$ + "'"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) >= 1 THEN
        RETURN "ERROR: username already taken"
    END IF

    sql$ = "SELECT 1 FROM app_gevelwering.service_user WHERE lower(email) = lower('" + e$ + "')"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) >= 1 THEN
        RETURN "ERROR: email already registered"
    END IF

    sql$ = "SELECT substr(encode(gen_random_bytes(12), 'hex'), 1, 16) AS temp_pw"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: failed to generate access password"
    END IF
    temp_pw$ = POSTGRES_GET_BY_NAME$(rid%, 0, "temp_pw")

    sql$ = "INSERT INTO app_gevelwering.service_user (username, email, display_name, password_hash, must_change_password) VALUES (" + _
        "'" + u$ + "', '" + e$ + "', '" + d$ + "', crypt('" + SUBSTITUTE$(temp_pw$, "'", "''") + "', gen_salt('bf')), true) " + _
        "RETURNING id::text AS id"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: registration failed: " + POSTGRES_GET_ERROR$(g_conn%)
    END IF
    user_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "id")

    sql$ = "INSERT INTO app_gevelwering.access_request (username, email, display_name, user_id, mail_status) VALUES (" + _
        "'" + u$ + "', '" + e$ + "', '" + d$ + "', '" + user_id$ + "'::uuid, 'SENT')"
    rid% = POSTGRES_QUERY(g_conn%, sql$)

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true,"
    out$ = out$ + CHR$(34) + "username" + CHR$(34) + ":" + CHR$(34) + u$ + CHR$(34) + ","
    out$ = out$ + CHR$(34) + "email" + CHR$(34) + ":" + CHR$(34) + e$ + CHR$(34) + ","
    out$ = out$ + CHR$(34) + "access_password" + CHR$(34) + ":" + CHR$(34) + temp_pw$ + CHR$(34) + ","
    out$ = out$ + CHR$(34) + "message" + CHR$(34) + ":" + CHR$(34) + "Access password issued (P0: shown here; production mails to registrant)." + CHR$(34) + "}"
    RETURN out$
END PROCEDURE

PROCEDURE API_ChangePassword(session_token$, current_password$, new_password$) AS STRING
    DIM sql$, rid%, t$, cp$, np$, user_id$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF
    IF current_password$ = "" OR new_password$ = "" THEN
        RETURN "ERROR: current and new password are required"
    END IF
    IF LEN(new_password$) < 6 THEN
        RETURN "ERROR: new password must be at least 6 characters"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    cp$ = SUBSTITUTE$(current_password$, "'", "''")
    np$ = SUBSTITUTE$(new_password$, "'", "''")

    sql$ = "UPDATE app_gevelwering.service_user u SET password_hash = crypt('" + np$ + "', gen_salt('bf')), " + _
        "must_change_password = false, updated_at = now() " + _
        "FROM app_gevelwering.login_session s " + _
        "WHERE s.user_id = u.id AND s.token = '" + t$ + "' " + _
        "AND s.revoked_at IS NULL AND s.expires_at > now() AND u.is_active = true " + _
        "AND u.password_hash = crypt('" + cp$ + "', u.password_hash) " + _
        "RETURNING u.id::text AS id"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: current password incorrect or session invalid"
    END IF
    user_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "id")
    RETURN "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "user_id" + CHR$(34) + ":" + CHR$(34) + user_id$ + CHR$(34) + "," + CHR$(34) + "must_change_password" + CHR$(34) + ":false}"
END PROCEDURE

PROCEDURE API_AdminListCustomers(session_token$) AS STRING
    DIM sql$, rid%, n%, i%, out$, t$, username$
    DIM c_id$, c_name$, project_count$, outstanding_count$, drawing_count$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.username " + _
        "FROM app_gevelwering.login_session s " + _
        "JOIN app_gevelwering.service_user u ON u.id = s.user_id " + _
        "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL " + _
        "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    username$ = POSTGRES_GET_BY_NAME$(rid%, 0, "username")
    IF username$ <> "admin" THEN
        RETURN "ERROR: admin access required"
    END IF

    sql$ = "SELECT c.id::text AS customer_id, c.name AS customer_name, " + _
        "COUNT(b.id)::text AS project_count, " + _
        "COUNT(b.id) FILTER (WHERE b.project_status <> 'PROJECT_FINISHED'::app_gevelwering.project_status)::text AS outstanding_count, " + _
        "(SELECT COUNT(*)::text FROM app_gevelwering.document d JOIN app_gevelwering.building bx ON bx.id = d.building_id WHERE bx.customer_id = c.id) AS drawing_count " + _
        "FROM app_gevelwering.customer c " + _
        "JOIN app_gevelwering.building b ON b.customer_id = c.id " + _
        "GROUP BY c.id, c.name " + _
        "ORDER BY c.name"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    n% = POSTGRES_NUM_ROWS(rid%)

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "customers" + CHR$(34) + ":["
    i% = 0
    WHILE i% < n%
        IF i% > 0 THEN
            out$ = out$ + ","
        END IF
        c_id$ = POSTGRES_GET_BY_NAME$(rid%, i%, "customer_id")
        c_name$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "customer_name"), CHR$(34), "")
        project_count$ = POSTGRES_GET_BY_NAME$(rid%, i%, "project_count")
        outstanding_count$ = POSTGRES_GET_BY_NAME$(rid%, i%, "outstanding_count")
        drawing_count$ = POSTGRES_GET_BY_NAME$(rid%, i%, "drawing_count")
        out$ = out$ + "{" + CHR$(34) + "customer_id" + CHR$(34) + ":" + CHR$(34) + c_id$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "customer_name" + CHR$(34) + ":" + CHR$(34) + c_name$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "project_count" + CHR$(34) + ":" + CHR$(34) + project_count$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "outstanding_count" + CHR$(34) + ":" + CHR$(34) + outstanding_count$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "drawing_count" + CHR$(34) + ":" + CHR$(34) + drawing_count$ + CHR$(34) + "}"
        i% = i% + 1
    WEND
    out$ = out$ + "]}"
    RETURN out$
END PROCEDURE

PROCEDURE API_AdminListCustomerProjects(session_token$, customer_id$) AS STRING
    DIM sql$, rid%, n%, i%, out$, t$, username$, cid$
    DIM b_id$, b_label$, b_ref$, project_status$, created_at$, drawing_count$, drawing_names$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" OR customer_id$ = "" THEN
        RETURN "ERROR: session_token and customer_id are required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    cid$ = SUBSTITUTE$(customer_id$, "'", "''")

    sql$ = "SELECT u.username " + _
        "FROM app_gevelwering.login_session s " + _
        "JOIN app_gevelwering.service_user u ON u.id = s.user_id " + _
        "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL " + _
        "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    username$ = POSTGRES_GET_BY_NAME$(rid%, 0, "username")
    IF username$ <> "admin" THEN
        RETURN "ERROR: admin access required"
    END IF

    sql$ = "SELECT b.id::text AS building_id, COALESCE(b.label,'') AS label, " + _
        "COALESCE(b.external_ref,'') AS external_ref, b.project_status::text AS project_status, " + _
        "b.created_at::text AS created_at, " + _
        "(SELECT COUNT(*)::text FROM app_gevelwering.document d WHERE d.building_id = b.id) AS drawing_count, " + _
        "(SELECT COALESCE(string_agg(d.filename, ', ' ORDER BY d.created_at), '') FROM app_gevelwering.document d WHERE d.building_id = b.id) AS drawing_names " + _
        "FROM app_gevelwering.building b " + _
        "WHERE b.customer_id = '" + cid$ + "'::uuid " + _
        "ORDER BY b.created_at DESC"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    n% = POSTGRES_NUM_ROWS(rid%)

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "customer_id" + CHR$(34) + ":" + CHR$(34) + cid$ + CHR$(34) + "," + CHR$(34) + "projects" + CHR$(34) + ":["
    i% = 0
    WHILE i% < n%
        IF i% > 0 THEN
            out$ = out$ + ","
        END IF
        b_id$ = POSTGRES_GET_BY_NAME$(rid%, i%, "building_id")
        b_label$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "label"), CHR$(34), "")
        b_ref$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "external_ref"), CHR$(34), "")
        project_status$ = POSTGRES_GET_BY_NAME$(rid%, i%, "project_status")
        created_at$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "created_at"), CHR$(34), "")
        drawing_count$ = POSTGRES_GET_BY_NAME$(rid%, i%, "drawing_count")
        drawing_names$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "drawing_names"), CHR$(34), "")
        out$ = out$ + "{" + CHR$(34) + "building_id" + CHR$(34) + ":" + CHR$(34) + b_id$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "label" + CHR$(34) + ":" + CHR$(34) + b_label$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "external_ref" + CHR$(34) + ":" + CHR$(34) + b_ref$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "project_status" + CHR$(34) + ":" + CHR$(34) + project_status$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "created_at" + CHR$(34) + ":" + CHR$(34) + created_at$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "drawing_count" + CHR$(34) + ":" + CHR$(34) + drawing_count$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "drawing_names" + CHR$(34) + ":" + CHR$(34) + drawing_names$ + CHR$(34) + "}"
        i% = i% + 1
    WEND
    out$ = out$ + "]}"
    RETURN out$
END PROCEDURE

PROCEDURE API_AdminUpdateProjectStatus(session_token$, building_id$, project_status$) AS STRING
    DIM sql$, rid%, t$, username$, b_id$, ps$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" OR building_id$ = "" OR project_status$ = "" THEN
        RETURN "ERROR: session_token, building_id, and project_status are required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    b_id$ = SUBSTITUTE$(building_id$, "'", "''")
    ps$ = SUBSTITUTE$(project_status$, "'", "''")

    IF ps$ <> "INITIAL_REQUEST" AND ps$ <> "PROJECT_DATA_SUPPLIED_NOT_YET_PROCESSED" AND ps$ <> "PROJECT_UNDERWAY" AND ps$ <> "PROJECT_NEAR_FINAL" AND ps$ <> "PROJECT_FINISHED" THEN
        RETURN "ERROR: invalid project_status"
    END IF

    sql$ = "SELECT u.username " + _
        "FROM app_gevelwering.login_session s " + _
        "JOIN app_gevelwering.service_user u ON u.id = s.user_id " + _
        "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL " + _
        "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    username$ = POSTGRES_GET_BY_NAME$(rid%, 0, "username")
    IF username$ <> "admin" THEN
        RETURN "ERROR: admin access required"
    END IF

    sql$ = "UPDATE app_gevelwering.building " + _
        "SET project_status = '" + ps$ + "'::app_gevelwering.project_status, updated_at = now() " + _
        "WHERE id = '" + b_id$ + "'::uuid " + _
        "RETURNING id::text AS id"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: building not found"
    END IF

    RETURN "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "building_id" + CHR$(34) + ":" + CHR$(34) + b_id$ + CHR$(34) + "," + CHR$(34) + "project_status" + CHR$(34) + ":" + CHR$(34) + ps$ + CHR$(34) + "}"
END PROCEDURE

REM --- Admin material catalog (app_gevelwering.material / catalogusGG.pdf) ---

PROCEDURE API_AdminListMaterials(session_token$, q$, category$, limit$, offset$, source_filter$) AS STRING
    DIM sql$, rid%, n%, i%, out$, t$, username$, qq$, cat$, lim$, off$, total$, sfilt$
    DIM mid$, cid$, mno$, mname$, mcat$, mmaster$, thick$, wt$, ra$
    DIM r63$, r125$, r250$, r500$, r1k$, r2k$, r4k$, rw$, c$, ctr$
    DIM gt1$, gcav$, gt2$, bref$, src$, sok$
    DIM sep%, mm$, ss$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.username " + _
        "FROM app_gevelwering.login_session s " + _
        "JOIN app_gevelwering.service_user u ON u.id = s.user_id " + _
        "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL " + _
        "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    username$ = POSTGRES_GET_BY_NAME$(rid%, 0, "username")
    IF username$ <> "admin" THEN
        RETURN "ERROR: admin access required"
    END IF

    qq$ = SUBSTITUTE$(q$, "'", "''")
    cat$ = SUBSTITUTE$(category$, "'", "''")
    lim$ = SUBSTITUTE$(limit$, "'", "''")
    off$ = SUBSTITUTE$(offset$, "'", "''")
    sfilt$ = LCASE$(SUBSTITUTE$(source_filter$, "'", "''"))
    IF lim$ = "" THEN
        lim$ = "10"
    END IF
    IF off$ = "" THEN
        off$ = "0"
    END IF
    IF VAL(lim$) < 1 THEN
        lim$ = "10"
    END IF
    IF VAL(lim$) > 10 THEN
        lim$ = "10"
    END IF
    IF VAL(off$) < 0 THEN
        off$ = "0"
    END IF

    sql$ = "SELECT COUNT(*)::text AS total FROM app_gevelwering.material WHERE 1=1"
    IF qq$ <> "" THEN
        sql$ = sql$ + " AND (name ILIKE '%" + qq$ + "%' OR catalog_id ILIKE '%" + qq$ + "%')"
    END IF
    IF cat$ <> "" THEN
        sep% = INSTR(cat$, "::")
        IF sep% > 0 THEN
            mm$ = LEFT$(cat$, sep% - 1)
            ss$ = MID$(cat$, sep% + 2)
            sql$ = sql$ + " AND master_category = '" + mm$ + "'"
            IF ss$ <> "" THEN
                sql$ = sql$ + " AND category = '" + ss$ + "'"
            END IF
        ELSE
            sql$ = sql$ + " AND master_category = '" + cat$ + "'"
        END IF
    END IF
    IF sfilt$ = "eigen" THEN
        sql$ = sql$ + " AND source = 'eigen'"
    ELSE
        IF sfilt$ = "catalogus" OR sfilt$ = "catalog" THEN
            sql$ = sql$ + " AND COALESCE(source, '') <> 'eigen'"
        END IF
    END IF
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF rid% = -1 THEN
        RETURN "ERROR: material count failed: " + POSTGRES_GET_ERROR$(g_conn%)
    END IF
    total$ = POSTGRES_GET_BY_NAME$(rid%, 0, "total")

    sql$ = "SELECT id::text AS material_id, catalog_id, material_no::text AS material_no, " + _
        "master_category, name, COALESCE(category,'') AS category, " + _
        "COALESCE(thickness_mm::text,'') AS thickness_mm, " + _
        "COALESCE(weight_kg_m2::text,'') AS weight_kg_m2, " + _
        "COALESCE(ra_dba::text,'') AS ra_dba, " + _
        "COALESCE(r_63_hz::text,'') AS r_63_hz, " + _
        "COALESCE(r_125_hz::text,'') AS r_125_hz, " + _
        "COALESCE(r_250_hz::text,'') AS r_250_hz, " + _
        "COALESCE(r_500_hz::text,'') AS r_500_hz, " + _
        "COALESCE(r_1000_hz::text,'') AS r_1000_hz, " + _
        "COALESCE(r_2000_hz::text,'') AS r_2000_hz, " + _
        "COALESCE(r_4000_hz::text,'') AS r_4000_hz, " + _
        "COALESCE(rw_db::text,'') AS rw_db, " + _
        "COALESCE(c_db::text,'') AS c_db, " + _
        "COALESCE(ctr_db::text,'') AS ctr_db, " + _
        "COALESCE(glass_t1_mm::text,'') AS glass_t1_mm, " + _
        "COALESCE(glass_cavity_mm::text,'') AS glass_cavity_mm, " + _
        "COALESCE(glass_t2_mm::text,'') AS glass_t2_mm, " + _
        "COALESCE(source_ref,'') AS source_ref, " + _
        "COALESCE(source,'') AS source, " + _
        "spectrum_ok::text AS spectrum_ok " + _
        "FROM app_gevelwering.material WHERE 1=1"
    IF qq$ <> "" THEN
        sql$ = sql$ + " AND (name ILIKE '%" + qq$ + "%' OR catalog_id ILIKE '%" + qq$ + "%')"
    END IF
    IF cat$ <> "" THEN
        sep% = INSTR(cat$, "::")
        IF sep% > 0 THEN
            mm$ = LEFT$(cat$, sep% - 1)
            ss$ = MID$(cat$, sep% + 2)
            sql$ = sql$ + " AND master_category = '" + mm$ + "'"
            IF ss$ <> "" THEN
                sql$ = sql$ + " AND category = '" + ss$ + "'"
            END IF
        ELSE
            sql$ = sql$ + " AND master_category = '" + cat$ + "'"
        END IF
    END IF
    IF sfilt$ = "eigen" THEN
        sql$ = sql$ + " AND source = 'eigen'"
    ELSE
        IF sfilt$ = "catalogus" OR sfilt$ = "catalog" THEN
            sql$ = sql$ + " AND COALESCE(source, '') <> 'eigen'"
        END IF
    END IF
    sql$ = sql$ + " ORDER BY master_category, category, material_no ASC LIMIT " + lim$ + " OFFSET " + off$
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF rid% = -1 THEN
        RETURN "ERROR: material list failed: " + POSTGRES_GET_ERROR$(g_conn%)
    END IF
    n% = POSTGRES_NUM_ROWS(rid%)

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true"
    out$ = out$ + "," + CHR$(34) + "total" + CHR$(34) + ":" + total$
    out$ = out$ + "," + CHR$(34) + "limit" + CHR$(34) + ":" + lim$
    out$ = out$ + "," + CHR$(34) + "offset" + CHR$(34) + ":" + off$
    out$ = out$ + "," + CHR$(34) + "materials" + CHR$(34) + ":["
    i% = 0
    WHILE i% < n%
        IF i% > 0 THEN
            out$ = out$ + ","
        END IF
        mid$ = POSTGRES_GET_BY_NAME$(rid%, i%, "material_id")
        cid$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "catalog_id"), CHR$(34), "")
        mno$ = POSTGRES_GET_BY_NAME$(rid%, i%, "material_no")
        mmaster$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "master_category"), CHR$(34), "")
        mname$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "name"), CHR$(34), "")
        mcat$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "category"), CHR$(34), "")
        thick$ = POSTGRES_GET_BY_NAME$(rid%, i%, "thickness_mm")
        wt$ = POSTGRES_GET_BY_NAME$(rid%, i%, "weight_kg_m2")
        ra$ = POSTGRES_GET_BY_NAME$(rid%, i%, "ra_dba")
        r63$ = POSTGRES_GET_BY_NAME$(rid%, i%, "r_63_hz")
        r125$ = POSTGRES_GET_BY_NAME$(rid%, i%, "r_125_hz")
        r250$ = POSTGRES_GET_BY_NAME$(rid%, i%, "r_250_hz")
        r500$ = POSTGRES_GET_BY_NAME$(rid%, i%, "r_500_hz")
        r1k$ = POSTGRES_GET_BY_NAME$(rid%, i%, "r_1000_hz")
        r2k$ = POSTGRES_GET_BY_NAME$(rid%, i%, "r_2000_hz")
        r4k$ = POSTGRES_GET_BY_NAME$(rid%, i%, "r_4000_hz")
        rw$ = POSTGRES_GET_BY_NAME$(rid%, i%, "rw_db")
        c$ = POSTGRES_GET_BY_NAME$(rid%, i%, "c_db")
        ctr$ = POSTGRES_GET_BY_NAME$(rid%, i%, "ctr_db")
        gt1$ = POSTGRES_GET_BY_NAME$(rid%, i%, "glass_t1_mm")
        gcav$ = POSTGRES_GET_BY_NAME$(rid%, i%, "glass_cavity_mm")
        gt2$ = POSTGRES_GET_BY_NAME$(rid%, i%, "glass_t2_mm")
        bref$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "source_ref"), CHR$(34), "")
        src$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "source"), CHR$(34), "")
        sok$ = POSTGRES_GET_BY_NAME$(rid%, i%, "spectrum_ok")
        out$ = out$ + "{" + CHR$(34) + "material_id" + CHR$(34) + ":" + CHR$(34) + mid$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "catalog_id" + CHR$(34) + ":" + CHR$(34) + cid$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "material_no" + CHR$(34) + ":" + mno$
        out$ = out$ + "," + CHR$(34) + "master_category" + CHR$(34) + ":" + CHR$(34) + mmaster$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "name" + CHR$(34) + ":" + CHR$(34) + mname$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "category" + CHR$(34) + ":" + CHR$(34) + mcat$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "thickness_mm" + CHR$(34) + ":" + CHR$(34) + thick$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "weight_kg_m2" + CHR$(34) + ":" + CHR$(34) + wt$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "ra_dba" + CHR$(34) + ":" + CHR$(34) + ra$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "r_63_hz" + CHR$(34) + ":" + CHR$(34) + r63$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "r_125_hz" + CHR$(34) + ":" + CHR$(34) + r125$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "r_250_hz" + CHR$(34) + ":" + CHR$(34) + r250$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "r_500_hz" + CHR$(34) + ":" + CHR$(34) + r500$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "r_1000_hz" + CHR$(34) + ":" + CHR$(34) + r1k$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "r_2000_hz" + CHR$(34) + ":" + CHR$(34) + r2k$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "r_4000_hz" + CHR$(34) + ":" + CHR$(34) + r4k$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "rw_db" + CHR$(34) + ":" + CHR$(34) + rw$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "c_db" + CHR$(34) + ":" + CHR$(34) + c$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "ctr_db" + CHR$(34) + ":" + CHR$(34) + ctr$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "glass_t1_mm" + CHR$(34) + ":" + CHR$(34) + gt1$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "glass_cavity_mm" + CHR$(34) + ":" + CHR$(34) + gcav$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "glass_t2_mm" + CHR$(34) + ":" + CHR$(34) + gt2$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "source_ref" + CHR$(34) + ":" + CHR$(34) + bref$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "source" + CHR$(34) + ":" + CHR$(34) + src$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "spectrum_ok" + CHR$(34) + ":" + CHR$(34) + sok$ + CHR$(34) + "}"
        i% = i% + 1
    WEND
    out$ = out$ + "]}"
    RETURN out$
END PROCEDURE

PROCEDURE API_AdminGetMaterial(session_token$, material_id$) AS STRING
    DIM sql$, rid%, t$, username$, mid$
    DIM cid$, mno$, mmaster$, mname$, mcat$, thick$, wt$, ra$, bref$, sok$, src$
    DIM r63$, r125$, r250$, r500$, r1k$, r2k$, r4k$, rw$, c$, ctr$
    DIM supp$, phone$, build$, cavf$, lam$
    DIM t1$, cav$, t2$, rqa$, cflow$, dna$, h$, d$, l$, sh$, door$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" OR material_id$ = "" THEN
        RETURN "ERROR: session_token and material_id are required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    mid$ = SUBSTITUTE$(material_id$, "'", "''")
    sql$ = "SELECT u.username " + _
        "FROM app_gevelwering.login_session s " + _
        "JOIN app_gevelwering.service_user u ON u.id = s.user_id " + _
        "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL " + _
        "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    username$ = POSTGRES_GET_BY_NAME$(rid%, 0, "username")
    IF username$ <> "admin" THEN
        RETURN "ERROR: admin access required"
    END IF

    sql$ = "SELECT id::text AS material_id, catalog_id, material_no::text AS material_no, " + _
        "master_category, name, COALESCE(category,'') AS category, " + _
        "COALESCE(thickness_mm::text,'') AS thickness_mm, " + _
        "COALESCE(weight_kg_m2::text,'') AS weight_kg_m2, " + _
        "COALESCE(ra_dba::text,'') AS ra_dba, COALESCE(source_ref,'') AS source_ref, " + _
        "COALESCE(r_63_hz::text,'') AS r_63_hz, COALESCE(r_125_hz::text,'') AS r_125_hz, " + _
        "COALESCE(r_250_hz::text,'') AS r_250_hz, COALESCE(r_500_hz::text,'') AS r_500_hz, " + _
        "COALESCE(r_1000_hz::text,'') AS r_1000_hz, COALESCE(r_2000_hz::text,'') AS r_2000_hz, " + _
        "COALESCE(r_4000_hz::text,'') AS r_4000_hz, " + _
        "COALESCE(rw_db::text,'') AS rw_db, COALESCE(c_db::text,'') AS c_db, COALESCE(ctr_db::text,'') AS ctr_db, " + _
        "spectrum_ok::text AS spectrum_ok, COALESCE(supplier,'') AS supplier, COALESCE(phone,'') AS phone, " + _
        "COALESCE(buildup,'') AS buildup, COALESCE(cavity_fill,'') AS cavity_fill, COALESCE(laminate,'') AS laminate, " + _
        "COALESCE(glass_t1_mm::text,'') AS glass_t1_mm, COALESCE(glass_cavity_mm::text,'') AS glass_cavity_mm, " + _
        "COALESCE(glass_t2_mm::text,'') AS glass_t2_mm, COALESCE(rqa_dba::text,'') AS rqa_dba, " + _
        "COALESCE(c_dm3_s::text,'') AS c_dm3_s, COALESCE(dna_dba::text,'') AS dna_dba, " + _
        "COALESCE(height_mm::text,'') AS height_mm, COALESCE(depth_mm::text,'') AS depth_mm, " + _
        "COALESCE(length_mm::text,'') AS length_mm, COALESCE(sh_mm::text,'') AS sh_mm, " + _
        "COALESCE(doorlaat_m2_m::text,'') AS doorlaat_m2_m, COALESCE(source,'') AS source " + _
        "FROM app_gevelwering.material WHERE id = '" + mid$ + "'::uuid"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF rid% = -1 THEN
        RETURN "ERROR: material get failed: " + POSTGRES_GET_ERROR$(g_conn%)
    END IF
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: material not found"
    END IF

    mid$ = POSTGRES_GET_BY_NAME$(rid%, 0, "material_id")
    cid$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, 0, "catalog_id"), CHR$(34), "")
    mno$ = POSTGRES_GET_BY_NAME$(rid%, 0, "material_no")
    mmaster$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, 0, "master_category"), CHR$(34), "")
    mname$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, 0, "name"), CHR$(34), "")
    mcat$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, 0, "category"), CHR$(34), "")
    thick$ = POSTGRES_GET_BY_NAME$(rid%, 0, "thickness_mm")
    wt$ = POSTGRES_GET_BY_NAME$(rid%, 0, "weight_kg_m2")
    ra$ = POSTGRES_GET_BY_NAME$(rid%, 0, "ra_dba")
    bref$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, 0, "source_ref"), CHR$(34), "")
    r63$ = POSTGRES_GET_BY_NAME$(rid%, 0, "r_63_hz")
    r125$ = POSTGRES_GET_BY_NAME$(rid%, 0, "r_125_hz")
    r250$ = POSTGRES_GET_BY_NAME$(rid%, 0, "r_250_hz")
    r500$ = POSTGRES_GET_BY_NAME$(rid%, 0, "r_500_hz")
    r1k$ = POSTGRES_GET_BY_NAME$(rid%, 0, "r_1000_hz")
    r2k$ = POSTGRES_GET_BY_NAME$(rid%, 0, "r_2000_hz")
    r4k$ = POSTGRES_GET_BY_NAME$(rid%, 0, "r_4000_hz")
    rw$ = POSTGRES_GET_BY_NAME$(rid%, 0, "rw_db")
    c$ = POSTGRES_GET_BY_NAME$(rid%, 0, "c_db")
    ctr$ = POSTGRES_GET_BY_NAME$(rid%, 0, "ctr_db")
    sok$ = POSTGRES_GET_BY_NAME$(rid%, 0, "spectrum_ok")
    supp$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, 0, "supplier"), CHR$(34), "")
    phone$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, 0, "phone"), CHR$(34), "")
    build$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, 0, "buildup"), CHR$(34), "")
    cavf$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, 0, "cavity_fill"), CHR$(34), "")
    lam$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, 0, "laminate"), CHR$(34), "")
    t1$ = POSTGRES_GET_BY_NAME$(rid%, 0, "glass_t1_mm")
    cav$ = POSTGRES_GET_BY_NAME$(rid%, 0, "glass_cavity_mm")
    t2$ = POSTGRES_GET_BY_NAME$(rid%, 0, "glass_t2_mm")
    rqa$ = POSTGRES_GET_BY_NAME$(rid%, 0, "rqa_dba")
    cflow$ = POSTGRES_GET_BY_NAME$(rid%, 0, "c_dm3_s")
    dna$ = POSTGRES_GET_BY_NAME$(rid%, 0, "dna_dba")
    h$ = POSTGRES_GET_BY_NAME$(rid%, 0, "height_mm")
    d$ = POSTGRES_GET_BY_NAME$(rid%, 0, "depth_mm")
    l$ = POSTGRES_GET_BY_NAME$(rid%, 0, "length_mm")
    sh$ = POSTGRES_GET_BY_NAME$(rid%, 0, "sh_mm")
    door$ = POSTGRES_GET_BY_NAME$(rid%, 0, "doorlaat_m2_m")
    src$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, 0, "source"), CHR$(34), "")

    RETURN "{" + CHR$(34) + "ok" + CHR$(34) + ":true" + _
        "," + CHR$(34) + "material_id" + CHR$(34) + ":" + CHR$(34) + mid$ + CHR$(34) + _
        "," + CHR$(34) + "catalog_id" + CHR$(34) + ":" + CHR$(34) + cid$ + CHR$(34) + _
        "," + CHR$(34) + "material_no" + CHR$(34) + ":" + mno$ + _
        "," + CHR$(34) + "master_category" + CHR$(34) + ":" + CHR$(34) + mmaster$ + CHR$(34) + _
        "," + CHR$(34) + "name" + CHR$(34) + ":" + CHR$(34) + mname$ + CHR$(34) + _
        "," + CHR$(34) + "category" + CHR$(34) + ":" + CHR$(34) + mcat$ + CHR$(34) + _
        "," + CHR$(34) + "thickness_mm" + CHR$(34) + ":" + CHR$(34) + thick$ + CHR$(34) + _
        "," + CHR$(34) + "weight_kg_m2" + CHR$(34) + ":" + CHR$(34) + wt$ + CHR$(34) + _
        "," + CHR$(34) + "ra_dba" + CHR$(34) + ":" + CHR$(34) + ra$ + CHR$(34) + _
        "," + CHR$(34) + "source_ref" + CHR$(34) + ":" + CHR$(34) + bref$ + CHR$(34) + _
        "," + CHR$(34) + "r_63_hz" + CHR$(34) + ":" + CHR$(34) + r63$ + CHR$(34) + _
        "," + CHR$(34) + "r_125_hz" + CHR$(34) + ":" + CHR$(34) + r125$ + CHR$(34) + _
        "," + CHR$(34) + "r_250_hz" + CHR$(34) + ":" + CHR$(34) + r250$ + CHR$(34) + _
        "," + CHR$(34) + "r_500_hz" + CHR$(34) + ":" + CHR$(34) + r500$ + CHR$(34) + _
        "," + CHR$(34) + "r_1000_hz" + CHR$(34) + ":" + CHR$(34) + r1k$ + CHR$(34) + _
        "," + CHR$(34) + "r_2000_hz" + CHR$(34) + ":" + CHR$(34) + r2k$ + CHR$(34) + _
        "," + CHR$(34) + "r_4000_hz" + CHR$(34) + ":" + CHR$(34) + r4k$ + CHR$(34) + _
        "," + CHR$(34) + "rw_db" + CHR$(34) + ":" + CHR$(34) + rw$ + CHR$(34) + _
        "," + CHR$(34) + "c_db" + CHR$(34) + ":" + CHR$(34) + c$ + CHR$(34) + _
        "," + CHR$(34) + "ctr_db" + CHR$(34) + ":" + CHR$(34) + ctr$ + CHR$(34) + _
        "," + CHR$(34) + "spectrum_ok" + CHR$(34) + ":" + CHR$(34) + sok$ + CHR$(34) + _
        "," + CHR$(34) + "supplier" + CHR$(34) + ":" + CHR$(34) + supp$ + CHR$(34) + _
        "," + CHR$(34) + "phone" + CHR$(34) + ":" + CHR$(34) + phone$ + CHR$(34) + _
        "," + CHR$(34) + "buildup" + CHR$(34) + ":" + CHR$(34) + build$ + CHR$(34) + _
        "," + CHR$(34) + "cavity_fill" + CHR$(34) + ":" + CHR$(34) + cavf$ + CHR$(34) + _
        "," + CHR$(34) + "laminate" + CHR$(34) + ":" + CHR$(34) + lam$ + CHR$(34) + _
        "," + CHR$(34) + "glass_t1_mm" + CHR$(34) + ":" + CHR$(34) + t1$ + CHR$(34) + _
        "," + CHR$(34) + "glass_cavity_mm" + CHR$(34) + ":" + CHR$(34) + cav$ + CHR$(34) + _
        "," + CHR$(34) + "glass_t2_mm" + CHR$(34) + ":" + CHR$(34) + t2$ + CHR$(34) + _
        "," + CHR$(34) + "rqa_dba" + CHR$(34) + ":" + CHR$(34) + rqa$ + CHR$(34) + _
        "," + CHR$(34) + "c_dm3_s" + CHR$(34) + ":" + CHR$(34) + cflow$ + CHR$(34) + _
        "," + CHR$(34) + "dna_dba" + CHR$(34) + ":" + CHR$(34) + dna$ + CHR$(34) + _
        "," + CHR$(34) + "height_mm" + CHR$(34) + ":" + CHR$(34) + h$ + CHR$(34) + _
        "," + CHR$(34) + "depth_mm" + CHR$(34) + ":" + CHR$(34) + d$ + CHR$(34) + _
        "," + CHR$(34) + "length_mm" + CHR$(34) + ":" + CHR$(34) + l$ + CHR$(34) + _
        "," + CHR$(34) + "sh_mm" + CHR$(34) + ":" + CHR$(34) + sh$ + CHR$(34) + _
        "," + CHR$(34) + "doorlaat_m2_m" + CHR$(34) + ":" + CHR$(34) + door$ + CHR$(34) + _
        "," + CHR$(34) + "source" + CHR$(34) + ":" + CHR$(34) + src$ + CHR$(34) + "}"
END PROCEDURE

PROCEDURE API_AdminSaveMaterial(session_token$, material_id$, catalog_id$, master_category$, material_no$, name$, category$, thickness$, weight$, ra$, source_ref$, spectrum_ok$, r63$, r125$, r250$, r500$, r1000$, r2000$, r4000$, rw$, c$, ctr$, glass_t1$, glass_cavity$, glass_t2$, source$) AS STRING
    DIM sql$, rid%, t$, username$, mid$, cid$, mmaster$, mno$, mname$, mcat$, thick$, wt$, ra$, bref$, sok$, src$
    DIM a63$, a125$, a250$, a500$, a1k$, a2k$, a4k$, arw$, ac$, actr$, at1$, acav$, at2$, sok_sql$
    DIM n_thick$, n_wt$, n_ra$, n63$, n125$, n250$, n500$, n1k$, n2k$, n4k$, n_rw$, n_c$, n_ctr$, n_t1$, n_cav$, n_t2$, cidx$, out_id$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" OR name$ = "" OR master_category$ = "" THEN
        RETURN "ERROR: session_token, name, and master_category are required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.username " + _
        "FROM app_gevelwering.login_session s " + _
        "JOIN app_gevelwering.service_user u ON u.id = s.user_id " + _
        "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL " + _
        "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    username$ = POSTGRES_GET_BY_NAME$(rid%, 0, "username")
    IF username$ <> "admin" THEN
        RETURN "ERROR: admin access required"
    END IF

    mid$ = SUBSTITUTE$(material_id$, "'", "''")
    cid$ = SUBSTITUTE$(catalog_id$, "'", "''")
    mmaster$ = SUBSTITUTE$(master_category$, "'", "''")
    mno$ = SUBSTITUTE$(material_no$, "'", "''")
    mname$ = SUBSTITUTE$(name$, "'", "''")
    mcat$ = SUBSTITUTE$(category$, "'", "''")
    thick$ = SUBSTITUTE$(thickness$, "'", "''")
    wt$ = SUBSTITUTE$(weight$, "'", "''")
    ra$ = SUBSTITUTE$(ra$, "'", "''")
    bref$ = SUBSTITUTE$(source_ref$, "'", "''")
    sok$ = LCASE$(spectrum_ok$)
    a63$ = SUBSTITUTE$(r63$, "'", "''")
    a125$ = SUBSTITUTE$(r125$, "'", "''")
    a250$ = SUBSTITUTE$(r250$, "'", "''")
    a500$ = SUBSTITUTE$(r500$, "'", "''")
    a1k$ = SUBSTITUTE$(r1000$, "'", "''")
    a2k$ = SUBSTITUTE$(r2000$, "'", "''")
    a4k$ = SUBSTITUTE$(r4000$, "'", "''")
    arw$ = SUBSTITUTE$(rw$, "'", "''")
    ac$ = SUBSTITUTE$(c$, "'", "''")
    actr$ = SUBSTITUTE$(ctr$, "'", "''")
    at1$ = SUBSTITUTE$(glass_t1$, "'", "''")
    acav$ = SUBSTITUTE$(glass_cavity$, "'", "''")
    at2$ = SUBSTITUTE$(glass_t2$, "'", "''")
    src$ = SUBSTITUTE$(source$, "'", "''")
    IF src$ = "" THEN
        src$ = "eigen"
    END IF
    REM New rows and custom catalog ids (P…/E…, not DGMR D…) must not use catalog seed sources.
    IF mid$ = "" THEN
        src$ = "eigen"
    END IF
    IF (src$ = "catalogusGG.pdf" OR src$ = "GL.cat") AND LEFT$(UCASE$(cid$), 1) <> "D" THEN
        src$ = "eigen"
    END IF
    IF sok$ = "1" OR sok$ = "true" OR sok$ = "t" OR sok$ = "yes" THEN
        sok_sql$ = "true"
    ELSE
        sok_sql$ = "false"
    END IF

    IF thick$ = "" THEN
        n_thick$ = "NULL"
    ELSE
        n_thick$ = STR$(VAL(thick$))
    END IF
    IF wt$ = "" THEN
        n_wt$ = "NULL"
    ELSE
        n_wt$ = STR$(VAL(wt$))
    END IF
    IF ra$ = "" THEN
        n_ra$ = "NULL"
    ELSE
        n_ra$ = STR$(VAL(ra$))
    END IF
    IF a63$ = "" THEN
        n63$ = "NULL"
    ELSE
        n63$ = STR$(VAL(a63$))
    END IF
    IF a125$ = "" THEN
        n125$ = "NULL"
    ELSE
        n125$ = STR$(VAL(a125$))
    END IF
    IF a250$ = "" THEN
        n250$ = "NULL"
    ELSE
        n250$ = STR$(VAL(a250$))
    END IF
    IF a500$ = "" THEN
        n500$ = "NULL"
    ELSE
        n500$ = STR$(VAL(a500$))
    END IF
    IF a1k$ = "" THEN
        n1k$ = "NULL"
    ELSE
        n1k$ = STR$(VAL(a1k$))
    END IF
    IF a2k$ = "" THEN
        n2k$ = "NULL"
    ELSE
        n2k$ = STR$(VAL(a2k$))
    END IF
    IF a4k$ = "" THEN
        n4k$ = "NULL"
    ELSE
        n4k$ = STR$(VAL(a4k$))
    END IF
    IF arw$ = "" THEN
        n_rw$ = "NULL"
    ELSE
        n_rw$ = STR$(VAL(arw$))
    END IF
    IF ac$ = "" THEN
        n_c$ = "NULL"
    ELSE
        n_c$ = STR$(VAL(ac$))
    END IF
    IF actr$ = "" THEN
        n_ctr$ = "NULL"
    ELSE
        n_ctr$ = STR$(VAL(actr$))
    END IF
    IF at1$ = "" THEN
        n_t1$ = "NULL"
    ELSE
        n_t1$ = STR$(VAL(at1$))
    END IF
    IF acav$ = "" THEN
        n_cav$ = "NULL"
    ELSE
        n_cav$ = STR$(VAL(acav$))
    END IF
    IF at2$ = "" THEN
        n_t2$ = "NULL"
    ELSE
        n_t2$ = STR$(VAL(at2$))
    END IF

    IF mid$ = "" THEN
        IF cid$ = "" THEN
            RETURN "ERROR: catalog_id is required when creating"
        END IF
        IF mno$ = "" THEN
            sql$ = "SELECT (COALESCE(MAX(material_no), 0) + 1)::text AS next_no FROM app_gevelwering.material WHERE source = '" + src$ + "'"
            rid% = POSTGRES_QUERY(g_conn%, sql$)
            IF rid% = -1 OR POSTGRES_NUM_ROWS(rid%) < 1 THEN
                RETURN "ERROR: next material_no failed: " + POSTGRES_GET_ERROR$(g_conn%)
            END IF
            mno$ = POSTGRES_GET_BY_NAME$(rid%, 0, "next_no")
        END IF
        sql$ = "SELECT (COALESCE(MAX(catalog_index), -1) + 1)::text AS next_idx FROM app_gevelwering.material WHERE source = '" + src$ + "'"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
        IF rid% = -1 OR POSTGRES_NUM_ROWS(rid%) < 1 THEN
            RETURN "ERROR: next catalog_index failed: " + POSTGRES_GET_ERROR$(g_conn%)
        END IF
        cidx$ = POSTGRES_GET_BY_NAME$(rid%, 0, "next_idx")

        sql$ = "INSERT INTO app_gevelwering.material (" + _
            "catalog_index, catalog_id, material_no, master_category, name, category, " + _
            "thickness_mm, weight_kg_m2, ra_dba, source_ref, " + _
            "r_63_hz, r_125_hz, r_250_hz, r_500_hz, r_1000_hz, r_2000_hz, r_4000_hz, " + _
            "rw_db, c_db, ctr_db, glass_t1_mm, glass_cavity_mm, glass_t2_mm, r_db, spectrum_ok, source" + _
            ") VALUES (" + cidx$ + ", '" + cid$ + "', " + mno$ + ", '" + mmaster$ + "', '" + mname$ + "', "
        IF mcat$ = "" THEN
            sql$ = sql$ + "NULL, "
        ELSE
            sql$ = sql$ + "'" + mcat$ + "', "
        END IF
        sql$ = sql$ + n_thick$ + ", " + n_wt$ + ", " + n_ra$ + ", "
        IF bref$ = "" THEN
            sql$ = sql$ + "NULL, "
        ELSE
            sql$ = sql$ + "'" + bref$ + "', "
        END IF
        sql$ = sql$ + n63$ + ", " + n125$ + ", " + n250$ + ", " + n500$ + ", " + n1k$ + ", " + n2k$ + ", " + n4k$ + ", "
        sql$ = sql$ + n_rw$ + ", " + n_c$ + ", " + n_ctr$ + ", " + n_t1$ + ", " + n_cav$ + ", " + n_t2$ + ", "
        IF n63$ = "NULL" OR n125$ = "NULL" OR n250$ = "NULL" OR n500$ = "NULL" OR n1k$ = "NULL" OR n2k$ = "NULL" THEN
            sql$ = sql$ + "NULL, "
        ELSE
            sql$ = sql$ + "ARRAY[" + n63$ + "," + n125$ + "," + n250$ + "," + n500$ + "," + n1k$ + "," + n2k$ + "]::double precision[], "
        END IF
        sql$ = sql$ + sok_sql$ + ", '" + src$ + "') RETURNING id::text AS material_id, material_no::text AS material_no"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
        IF rid% = -1 THEN
            RETURN "ERROR: material insert failed: " + POSTGRES_GET_ERROR$(g_conn%)
        END IF
        IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
            RETURN "ERROR: material insert returned no row"
        END IF
        out_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "material_id")
        mno$ = POSTGRES_GET_BY_NAME$(rid%, 0, "material_no")
        RETURN "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "material_id" + CHR$(34) + ":" + CHR$(34) + out_id$ + CHR$(34) + "," + CHR$(34) + "material_no" + CHR$(34) + ":" + mno$ + "," + CHR$(34) + "created" + CHR$(34) + ":true}"
    END IF

    IF mno$ = "" OR cid$ = "" THEN
        RETURN "ERROR: catalog_id and material_no are required when updating"
    END IF

    sql$ = "UPDATE app_gevelwering.material SET catalog_id = '" + cid$ + "', material_no = " + mno$ + ", " + _
        "master_category = '" + mmaster$ + "', name = '" + mname$ + "', "
    IF mcat$ = "" THEN
        sql$ = sql$ + "category = NULL, "
    ELSE
        sql$ = sql$ + "category = '" + mcat$ + "', "
    END IF
    sql$ = sql$ + "thickness_mm = " + n_thick$ + ", weight_kg_m2 = " + n_wt$ + ", ra_dba = " + n_ra$ + ", "
    IF bref$ = "" THEN
        sql$ = sql$ + "source_ref = NULL, "
    ELSE
        sql$ = sql$ + "source_ref = '" + bref$ + "', "
    END IF
    sql$ = sql$ + "r_63_hz = " + n63$ + ", r_125_hz = " + n125$ + ", r_250_hz = " + n250$ + ", " + _
        "r_500_hz = " + n500$ + ", r_1000_hz = " + n1k$ + ", r_2000_hz = " + n2k$ + ", r_4000_hz = " + n4k$ + ", " + _
        "rw_db = " + n_rw$ + ", c_db = " + n_c$ + ", ctr_db = " + n_ctr$ + ", " + _
        "glass_t1_mm = " + n_t1$ + ", glass_cavity_mm = " + n_cav$ + ", glass_t2_mm = " + n_t2$ + ", "
    IF n63$ = "NULL" OR n125$ = "NULL" OR n250$ = "NULL" OR n500$ = "NULL" OR n1k$ = "NULL" OR n2k$ = "NULL" THEN
        sql$ = sql$ + "r_db = NULL, "
    ELSE
        sql$ = sql$ + "r_db = ARRAY[" + n63$ + "," + n125$ + "," + n250$ + "," + n500$ + "," + n1k$ + "," + n2k$ + "]::double precision[], "
    END IF
    sql$ = sql$ + "spectrum_ok = " + sok_sql$ + ", source = '" + src$ + "', updated_at = now() " + _
        "WHERE id = '" + mid$ + "'::uuid RETURNING id::text AS material_id, material_no::text AS material_no"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF rid% = -1 THEN
        RETURN "ERROR: material update failed: " + POSTGRES_GET_ERROR$(g_conn%)
    END IF
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: material not found"
    END IF
    out_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "material_id")
    mno$ = POSTGRES_GET_BY_NAME$(rid%, 0, "material_no")
    RETURN "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "material_id" + CHR$(34) + ":" + CHR$(34) + out_id$ + CHR$(34) + "," + CHR$(34) + "material_no" + CHR$(34) + ":" + mno$ + "," + CHR$(34) + "created" + CHR$(34) + ":false}"
END PROCEDURE

PROCEDURE API_AdminDeleteMaterial(session_token$, material_id$) AS STRING
    DIM sql$, rid%, t$, username$, mid$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" OR material_id$ = "" THEN
        RETURN "ERROR: session_token and material_id are required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    mid$ = SUBSTITUTE$(material_id$, "'", "''")
    sql$ = "SELECT u.username " + _
        "FROM app_gevelwering.login_session s " + _
        "JOIN app_gevelwering.service_user u ON u.id = s.user_id " + _
        "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL " + _
        "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    username$ = POSTGRES_GET_BY_NAME$(rid%, 0, "username")
    IF username$ <> "admin" THEN
        RETURN "ERROR: admin access required"
    END IF

    sql$ = "DELETE FROM app_gevelwering.material WHERE id = '" + mid$ + "'::uuid RETURNING id::text AS material_id"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF rid% = -1 THEN
        RETURN "ERROR: material delete failed: " + POSTGRES_GET_ERROR$(g_conn%)
    END IF
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: material not found"
    END IF
    RETURN "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "material_id" + CHR$(34) + ":" + CHR$(34) + mid$ + CHR$(34) + "}"
END PROCEDURE

PROCEDURE API_GetCustomerProfile(session_token$) AS STRING
    DIM sql$, rid%, t$, owner_id$, out$
    DIM c_id$, c_name$, c_email$, c_phone$, c_notes$
    DIM ca_street$, ca_postal$, ca_city$, ca_muni$, ca_country$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.id::text AS user_id FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    owner_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "user_id")

    sql$ = "SELECT c.id::text AS customer_id, c.name AS customer_name, COALESCE(c.email,'') AS email, " + _
        "COALESCE(c.phone,'') AS phone, COALESCE(c.notes,'') AS notes, " + _
        "COALESCE(ca.street_line,'') AS cust_street, COALESCE(ca.postal_code,'') AS cust_postal, " + _
        "COALESCE(ca.city,'') AS cust_city, COALESCE(ca.municipality,'') AS cust_municipality, " + _
        "COALESCE(ca.country_code,'NL') AS cust_country " + _
        "FROM app_gevelwering.customer c " + _
        "LEFT JOIN LATERAL (SELECT * FROM app_gevelwering.address x WHERE x.customer_id = c.id AND x.kind = 'CUSTOMER'::app_gevelwering.address_kind ORDER BY x.created_at DESC LIMIT 1) ca ON true " + _
        "WHERE c.owner_user_id = '" + owner_id$ + "'::uuid LIMIT 1"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "customer" + CHR$(34) + ":null}"
    END IF

    c_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "customer_id")
    c_name$ = POSTGRES_GET_BY_NAME$(rid%, 0, "customer_name")
    c_email$ = POSTGRES_GET_BY_NAME$(rid%, 0, "email")
    c_phone$ = POSTGRES_GET_BY_NAME$(rid%, 0, "phone")
    c_notes$ = POSTGRES_GET_BY_NAME$(rid%, 0, "notes")
    ca_street$ = POSTGRES_GET_BY_NAME$(rid%, 0, "cust_street")
    ca_postal$ = POSTGRES_GET_BY_NAME$(rid%, 0, "cust_postal")
    ca_city$ = POSTGRES_GET_BY_NAME$(rid%, 0, "cust_city")
    ca_muni$ = POSTGRES_GET_BY_NAME$(rid%, 0, "cust_municipality")
    ca_country$ = POSTGRES_GET_BY_NAME$(rid%, 0, "cust_country")

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true,"
    out$ = out$ + CHR$(34) + "customer" + CHR$(34) + ":{" + CHR$(34) + "id" + CHR$(34) + ":" + CHR$(34) + c_id$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "name" + CHR$(34) + ":" + CHR$(34) + c_name$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "email" + CHR$(34) + ":" + CHR$(34) + c_email$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "phone" + CHR$(34) + ":" + CHR$(34) + c_phone$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "notes" + CHR$(34) + ":" + CHR$(34) + c_notes$ + CHR$(34) + "},"
    out$ = out$ + CHR$(34) + "customer_address" + CHR$(34) + ":{" + CHR$(34) + "street_line" + CHR$(34) + ":" + CHR$(34) + ca_street$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "postal_code" + CHR$(34) + ":" + CHR$(34) + ca_postal$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "city" + CHR$(34) + ":" + CHR$(34) + ca_city$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "municipality" + CHR$(34) + ":" + CHR$(34) + ca_muni$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "country_code" + CHR$(34) + ":" + CHR$(34) + ca_country$ + CHR$(34) + "}}"
    RETURN out$
END PROCEDURE

PROCEDURE API_SaveCustomerProfile(session_token$, name$, email$, phone$, notes$, cust_street$, cust_postal$, cust_city$, cust_municipality$, cust_country$) AS STRING
    DIM sql$, customer_id$, cust_addr_id$, out$, cc$, owner_id$, t$
    DIM rid%

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF
    IF name$ = "" THEN
        RETURN "ERROR: name is required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.id::text AS user_id FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    owner_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "user_id")

    cc$ = cust_country$
    IF cc$ = "" THEN
        cc$ = "NL"
    END IF

    name$ = SUBSTITUTE$(name$, "'", "''")
    email$ = SUBSTITUTE$(email$, "'", "''")
    phone$ = SUBSTITUTE$(phone$, "'", "''")
    notes$ = SUBSTITUTE$(notes$, "'", "''")
    cust_street$ = SUBSTITUTE$(cust_street$, "'", "''")
    cust_postal$ = SUBSTITUTE$(cust_postal$, "'", "''")
    cust_city$ = SUBSTITUTE$(cust_city$, "'", "''")
    cust_municipality$ = SUBSTITUTE$(cust_municipality$, "'", "''")

    cust_addr_id$ = ""
    customer_id$ = ""

    sql$ = "SELECT id::text AS id FROM app_gevelwering.customer WHERE owner_user_id = '" + owner_id$ + "'::uuid LIMIT 1"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) >= 1 THEN
        customer_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "id")
        sql$ = "UPDATE app_gevelwering.customer SET name = '" + name$ + "', email = '" + email$ + "', phone = '" + phone$ + "', notes = '" + notes$ + "', updated_at = now() WHERE id = '" + customer_id$ + "'::uuid"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
    ELSE
        sql$ = "INSERT INTO app_gevelwering.customer (name, email, phone, notes, owner_user_id) VALUES ('" + name$ + "', '" + email$ + "', '" + phone$ + "', '" + notes$ + "', '" + owner_id$ + "'::uuid) RETURNING id::text AS id"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
        IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
            RETURN "ERROR: customer insert failed: " + POSTGRES_GET_ERROR$(g_conn%)
        END IF
        customer_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "id")
    END IF

    sql$ = "DELETE FROM app_gevelwering.address WHERE customer_id = '" + customer_id$ + "'::uuid AND kind = 'CUSTOMER'::app_gevelwering.address_kind"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF cust_street$ <> "" THEN
        sql$ = "INSERT INTO app_gevelwering.address (customer_id, kind, street_line, postal_code, city, municipality, country_code) VALUES ('" + customer_id$ + "'::uuid, 'CUSTOMER'::app_gevelwering.address_kind, '" + cust_street$ + "', '" + cust_postal$ + "', '" + cust_city$ + "', '" + cust_municipality$ + "', '" + cc$ + "') RETURNING id::text AS id"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
        IF POSTGRES_NUM_ROWS(rid%) >= 1 THEN
            cust_addr_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "id")
        END IF
    END IF

    g_db.Execute("SELECT 1")
    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "customer_id" + CHR$(34) + ":" + CHR$(34) + customer_id$ + CHR$(34) + "," + CHR$(34) + "customer_address_id" + CHR$(34) + ":" + CHR$(34) + cust_addr_id$ + CHR$(34) + "}"
    RETURN out$
END PROCEDURE

PROCEDURE API_ListBuildings(session_token$) AS STRING
    DIM sql$, rid%, n%, i%, out$, t$, owner_id$
    DIM b_id$, b_label$, b_ref$, c_name$, project_status$
    DIM d_street$, d_postal$, d_city$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.id::text AS user_id FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    owner_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "user_id")

    sql$ = "SELECT b.id::text AS building_id, COALESCE(b.label,'') AS label, COALESCE(b.external_ref,'') AS external_ref, " + _
        "c.name AS customer_name, b.project_status::text AS project_status, " + _
        "a.street_line AS dwell_street, a.postal_code AS dwell_postal, a.city AS dwell_city " + _
        "FROM app_gevelwering.building b " + _
        "JOIN app_gevelwering.customer c ON c.id = b.customer_id " + _
        "JOIN app_gevelwering.address a ON a.id = b.dwelling_address_id " + _
        "WHERE (b.owner_user_id = '" + owner_id$ + "'::uuid OR b.owner_user_id IS NULL) " + _
        "ORDER BY CASE b.project_status " + _
        "WHEN 'PROJECT_FINISHED'::app_gevelwering.project_status THEN 1 ELSE 0 END ASC, " + _
        "b.updated_at DESC"

    rid% = POSTGRES_QUERY(g_conn%, sql$)
    n% = POSTGRES_NUM_ROWS(rid%)
    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "projects" + CHR$(34) + ":["
    i% = 0
    WHILE i% < n%
        IF i% > 0 THEN
            out$ = out$ + ","
        END IF
        b_id$ = POSTGRES_GET_BY_NAME$(rid%, i%, "building_id")
        b_label$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "label"), CHR$(34), "")
        b_ref$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "external_ref"), CHR$(34), "")
        c_name$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "customer_name"), CHR$(34), "")
        project_status$ = POSTGRES_GET_BY_NAME$(rid%, i%, "project_status")
        d_street$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "dwell_street"), CHR$(34), "")
        d_postal$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "dwell_postal"), CHR$(34), "")
        d_city$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "dwell_city"), CHR$(34), "")
        out$ = out$ + "{" + CHR$(34) + "id" + CHR$(34) + ":" + CHR$(34) + b_id$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "label" + CHR$(34) + ":" + CHR$(34) + b_label$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "external_ref" + CHR$(34) + ":" + CHR$(34) + b_ref$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "customer_name" + CHR$(34) + ":" + CHR$(34) + c_name$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "project_status" + CHR$(34) + ":" + CHR$(34) + project_status$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "dwell_street" + CHR$(34) + ":" + CHR$(34) + d_street$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "dwell_postal" + CHR$(34) + ":" + CHR$(34) + d_postal$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "dwell_city" + CHR$(34) + ":" + CHR$(34) + d_city$ + CHR$(34) + "}"
        i% = i% + 1
    WEND
    out$ = out$ + "]}"
    RETURN out$
END PROCEDURE

PROCEDURE API_SaveBuildingEntry(session_token$, name$, email$, phone$, notes$, cust_street$, cust_postal$, cust_city$, cust_municipality$, cust_country$, dwell_street$, dwell_postal$, dwell_city$, dwell_municipality$, dwell_country$, label$, external_ref$, building_id$) AS STRING
    DIM sql$, customer_id$, cust_addr_id$, dwell_addr_id$, building_id_out$, out$, cc$, dc$, owner_id$, t$
    DIM rid%, n%, bid$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.id::text AS user_id FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    owner_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "user_id")
    g_auth_user_id$ = owner_id$
    g_auth_token$ = session_token$

    cc$ = cust_country$
    IF cc$ = "" THEN
        cc$ = "NL"
    END IF
    dc$ = dwell_country$
    IF dc$ = "" THEN
        dc$ = "NL"
    END IF

    IF name$ = "" THEN
        RETURN "ERROR: name is required"
    END IF
    IF dwell_street$ = "" OR dwell_postal$ = "" OR dwell_city$ = "" THEN
        RETURN "ERROR: dwelling address street, postal_code, and city are required"
    END IF

    name$ = SUBSTITUTE$(name$, "'", "''")
    email$ = SUBSTITUTE$(email$, "'", "''")
    phone$ = SUBSTITUTE$(phone$, "'", "''")
    notes$ = SUBSTITUTE$(notes$, "'", "''")
    cust_street$ = SUBSTITUTE$(cust_street$, "'", "''")
    cust_postal$ = SUBSTITUTE$(cust_postal$, "'", "''")
    cust_city$ = SUBSTITUTE$(cust_city$, "'", "''")
    cust_municipality$ = SUBSTITUTE$(cust_municipality$, "'", "''")
    dwell_street$ = SUBSTITUTE$(dwell_street$, "'", "''")
    dwell_postal$ = SUBSTITUTE$(dwell_postal$, "'", "''")
    dwell_city$ = SUBSTITUTE$(dwell_city$, "'", "''")
    dwell_municipality$ = SUBSTITUTE$(dwell_municipality$, "'", "''")
    label$ = SUBSTITUTE$(label$, "'", "''")
    external_ref$ = SUBSTITUTE$(external_ref$, "'", "''")
    bid$ = SUBSTITUTE$(building_id$, "'", "''")

    cust_addr_id$ = ""
    customer_id$ = ""

    sql$ = "SELECT id::text AS id FROM app_gevelwering.customer WHERE owner_user_id = '" + owner_id$ + "'::uuid LIMIT 1"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) >= 1 THEN
        customer_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "id")
        sql$ = "UPDATE app_gevelwering.customer SET name = '" + name$ + "', email = '" + email$ + "', phone = '" + phone$ + "', notes = '" + notes$ + "', updated_at = now() WHERE id = '" + customer_id$ + "'::uuid"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
    ELSE
        sql$ = "INSERT INTO app_gevelwering.customer (name, email, phone, notes, owner_user_id) VALUES ('" + name$ + "', '" + email$ + "', '" + phone$ + "', '" + notes$ + "', '" + owner_id$ + "'::uuid) RETURNING id::text AS id"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
        IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
            RETURN "ERROR: customer insert failed: " + POSTGRES_GET_ERROR$(g_conn%)
        END IF
        customer_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "id")
    END IF

    sql$ = "DELETE FROM app_gevelwering.address WHERE customer_id = '" + customer_id$ + "'::uuid AND kind = 'CUSTOMER'::app_gevelwering.address_kind"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF cust_street$ <> "" THEN
        sql$ = "INSERT INTO app_gevelwering.address (customer_id, kind, street_line, postal_code, city, municipality, country_code) VALUES ('" + customer_id$ + "'::uuid, 'CUSTOMER'::app_gevelwering.address_kind, '" + cust_street$ + "', '" + cust_postal$ + "', '" + cust_city$ + "', '" + cust_municipality$ + "', '" + cc$ + "') RETURNING id::text AS id"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
        IF POSTGRES_NUM_ROWS(rid%) >= 1 THEN
            cust_addr_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "id")
        END IF
    END IF

    IF bid$ <> "" THEN
        sql$ = "SELECT b.id::text AS id, b.dwelling_address_id::text AS dwell_id, b.project_status::text AS project_status " + _
            "FROM app_gevelwering.building b " + _
            "WHERE b.id = '" + bid$ + "'::uuid " + _
            "AND (b.owner_user_id = '" + owner_id$ + "'::uuid OR b.owner_user_id IS NULL)"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
        IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
            RETURN "ERROR: project not found"
        END IF
        IF POSTGRES_GET_BY_NAME$(rid%, 0, "project_status") <> "INITIAL_REQUEST" THEN
            RETURN "ERROR: project can only be edited while status is INITIAL_REQUEST"
        END IF
        dwell_addr_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "dwell_id")
        building_id_out$ = POSTGRES_GET_BY_NAME$(rid%, 0, "id")

        sql$ = "UPDATE app_gevelwering.address SET street_line = '" + dwell_street$ + "', postal_code = '" + dwell_postal$ + "', city = '" + dwell_city$ + "', municipality = '" + dwell_municipality$ + "', country_code = '" + dc$ + "', updated_at = now() WHERE id = '" + dwell_addr_id$ + "'::uuid"
        rid% = POSTGRES_QUERY(g_conn%, sql$)

        sql$ = "UPDATE app_gevelwering.building SET label = '" + label$ + "', external_ref = '" + external_ref$ + "', updated_at = now() WHERE id = '" + building_id_out$ + "'::uuid"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
    ELSE
        sql$ = "INSERT INTO app_gevelwering.address (customer_id, kind, street_line, postal_code, city, municipality, country_code) VALUES ('" + customer_id$ + "'::uuid, 'DWELLING'::app_gevelwering.address_kind, '" + dwell_street$ + "', '" + dwell_postal$ + "', '" + dwell_city$ + "', '" + dwell_municipality$ + "', '" + dc$ + "') RETURNING id::text AS id"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
        IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
            RETURN "ERROR: dwelling address insert failed: " + POSTGRES_GET_ERROR$(g_conn%)
        END IF
        dwell_addr_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "id")

        sql$ = "INSERT INTO app_gevelwering.building (customer_id, dwelling_address_id, label, external_ref, status, owner_user_id, project_status) VALUES ('" + customer_id$ + "'::uuid, '" + dwell_addr_id$ + "'::uuid, '" + label$ + "', '" + external_ref$ + "', 'DRAFT'::app_gevelwering.building_status, '" + owner_id$ + "'::uuid, 'INITIAL_REQUEST'::app_gevelwering.project_status) RETURNING id::text AS id"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
        IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
            RETURN "ERROR: project insert failed: " + POSTGRES_GET_ERROR$(g_conn%)
        END IF
        building_id_out$ = POSTGRES_GET_BY_NAME$(rid%, 0, "id")
    END IF

    g_db.Execute("SELECT 1")

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "building_id" + CHR$(34) + ":" + CHR$(34) + building_id_out$ + CHR$(34) + "," + CHR$(34) + "project_id" + CHR$(34) + ":" + CHR$(34) + building_id_out$ + CHR$(34) + "," + CHR$(34) + "customer_id" + CHR$(34) + ":" + CHR$(34) + customer_id$ + CHR$(34) + "," + CHR$(34) + "dwelling_address_id" + CHR$(34) + ":" + CHR$(34) + dwell_addr_id$ + CHR$(34) + "," + CHR$(34) + "customer_address_id" + CHR$(34) + ":" + CHR$(34) + cust_addr_id$ + CHR$(34) + "," + CHR$(34) + "owner_user_id" + CHR$(34) + ":" + CHR$(34) + owner_id$ + CHR$(34) + "}"
    RETURN out$
END PROCEDURE

PROCEDURE API_OpenBuilding(session_token$, building_id$) AS STRING
    DIM sql$, rid%, out$, t$, owner_id$
    DIM b_id$, b_label$, b_ref$, b_status$, c_id$, c_name$, c_email$, c_phone$, c_notes$, project_status$
    DIM d_street$, d_postal$, d_city$, d_muni$, d_country$
    DIM ca_street$, ca_postal$, ca_city$, ca_muni$, ca_country$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF
    IF building_id$ = "" THEN
        RETURN "ERROR: building_id is required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.id::text AS user_id FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    owner_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "user_id")

    sql$ = "SELECT b.id::text AS building_id, COALESCE(b.label,'') AS label, COALESCE(b.external_ref,'') AS external_ref, b.status::text AS status, b.project_status::text AS project_status, " + _
        "c.id::text AS customer_id, c.name AS customer_name, COALESCE(c.email,'') AS email, COALESCE(c.phone,'') AS phone, COALESCE(c.notes,'') AS notes, " + _
        "a.street_line, a.postal_code, a.city, COALESCE(a.municipality,'') AS municipality, a.country_code, " + _
        "COALESCE(ca.street_line,'') AS cust_street, COALESCE(ca.postal_code,'') AS cust_postal, " + _
        "COALESCE(ca.city,'') AS cust_city, COALESCE(ca.municipality,'') AS cust_municipality, " + _
        "COALESCE(ca.country_code,'') AS cust_country " + _
        "FROM app_gevelwering.building b " + _
        "JOIN app_gevelwering.customer c ON c.id = b.customer_id " + _
        "JOIN app_gevelwering.address a ON a.id = b.dwelling_address_id " + _
        "LEFT JOIN LATERAL (SELECT * FROM app_gevelwering.address x WHERE x.customer_id = c.id AND x.kind = 'CUSTOMER'::app_gevelwering.address_kind ORDER BY x.created_at DESC LIMIT 1) ca ON true " + _
        "WHERE b.id = '" + building_id$ + "'::uuid " + _
        "AND (b.owner_user_id = '" + owner_id$ + "'::uuid OR b.owner_user_id IS NULL)"

    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: building not found"
    END IF

    b_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "building_id")
    b_label$ = POSTGRES_GET_BY_NAME$(rid%, 0, "label")
    b_ref$ = POSTGRES_GET_BY_NAME$(rid%, 0, "external_ref")
    b_status$ = POSTGRES_GET_BY_NAME$(rid%, 0, "status")
    project_status$ = POSTGRES_GET_BY_NAME$(rid%, 0, "project_status")
    c_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "customer_id")
    c_name$ = POSTGRES_GET_BY_NAME$(rid%, 0, "customer_name")
    c_email$ = POSTGRES_GET_BY_NAME$(rid%, 0, "email")
    c_phone$ = POSTGRES_GET_BY_NAME$(rid%, 0, "phone")
    c_notes$ = POSTGRES_GET_BY_NAME$(rid%, 0, "notes")
    d_street$ = POSTGRES_GET_BY_NAME$(rid%, 0, "street_line")
    d_postal$ = POSTGRES_GET_BY_NAME$(rid%, 0, "postal_code")
    d_city$ = POSTGRES_GET_BY_NAME$(rid%, 0, "city")
    d_muni$ = POSTGRES_GET_BY_NAME$(rid%, 0, "municipality")
    d_country$ = POSTGRES_GET_BY_NAME$(rid%, 0, "country_code")
    ca_street$ = POSTGRES_GET_BY_NAME$(rid%, 0, "cust_street")
    ca_postal$ = POSTGRES_GET_BY_NAME$(rid%, 0, "cust_postal")
    ca_city$ = POSTGRES_GET_BY_NAME$(rid%, 0, "cust_city")
    ca_muni$ = POSTGRES_GET_BY_NAME$(rid%, 0, "cust_municipality")
    ca_country$ = POSTGRES_GET_BY_NAME$(rid%, 0, "cust_country")

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true,"
    out$ = out$ + CHR$(34) + "building" + CHR$(34) + ":{" + CHR$(34) + "id" + CHR$(34) + ":" + CHR$(34) + b_id$ + CHR$(34) + "," + CHR$(34) + "label" + CHR$(34) + ":" + CHR$(34) + b_label$ + CHR$(34) + "," + CHR$(34) + "external_ref" + CHR$(34) + ":" + CHR$(34) + b_ref$ + CHR$(34) + "," + CHR$(34) + "status" + CHR$(34) + ":" + CHR$(34) + b_status$ + CHR$(34) + "," + CHR$(34) + "project_status" + CHR$(34) + ":" + CHR$(34) + project_status$ + CHR$(34) + "},"
    out$ = out$ + CHR$(34) + "customer" + CHR$(34) + ":{" + CHR$(34) + "id" + CHR$(34) + ":" + CHR$(34) + c_id$ + CHR$(34) + "," + CHR$(34) + "name" + CHR$(34) + ":" + CHR$(34) + c_name$ + CHR$(34) + "," + CHR$(34) + "email" + CHR$(34) + ":" + CHR$(34) + c_email$ + CHR$(34) + "," + CHR$(34) + "phone" + CHR$(34) + ":" + CHR$(34) + c_phone$ + CHR$(34) + "," + CHR$(34) + "notes" + CHR$(34) + ":" + CHR$(34) + c_notes$ + CHR$(34) + "},"
    out$ = out$ + CHR$(34) + "customer_address" + CHR$(34) + ":{" + CHR$(34) + "street_line" + CHR$(34) + ":" + CHR$(34) + ca_street$ + CHR$(34) + "," + CHR$(34) + "postal_code" + CHR$(34) + ":" + CHR$(34) + ca_postal$ + CHR$(34) + "," + CHR$(34) + "city" + CHR$(34) + ":" + CHR$(34) + ca_city$ + CHR$(34) + "," + CHR$(34) + "municipality" + CHR$(34) + ":" + CHR$(34) + ca_muni$ + CHR$(34) + "," + CHR$(34) + "country_code" + CHR$(34) + ":" + CHR$(34) + ca_country$ + CHR$(34) + "},"
    out$ = out$ + CHR$(34) + "dwelling_address" + CHR$(34) + ":{" + CHR$(34) + "street_line" + CHR$(34) + ":" + CHR$(34) + d_street$ + CHR$(34) + "," + CHR$(34) + "postal_code" + CHR$(34) + ":" + CHR$(34) + d_postal$ + CHR$(34) + "," + CHR$(34) + "city" + CHR$(34) + ":" + CHR$(34) + d_city$ + CHR$(34) + "," + CHR$(34) + "municipality" + CHR$(34) + ":" + CHR$(34) + d_muni$ + CHR$(34) + "," + CHR$(34) + "country_code" + CHR$(34) + ":" + CHR$(34) + d_country$ + CHR$(34) + "}}"
    RETURN out$
END PROCEDURE

PROCEDURE API_DeleteProject(session_token$, building_id$) AS STRING
    DIM sql$, rid%, t$, owner_id$, b_id$, ps$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" OR building_id$ = "" THEN
        RETURN "ERROR: session_token and building_id are required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    b_id$ = SUBSTITUTE$(building_id$, "'", "''")

    sql$ = "SELECT u.id::text AS user_id FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    owner_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "user_id")

    sql$ = "SELECT b.project_status::text AS project_status " + _
        "FROM app_gevelwering.building b " + _
        "WHERE b.id = '" + b_id$ + "'::uuid " + _
        "AND (b.owner_user_id = '" + owner_id$ + "'::uuid OR b.owner_user_id IS NULL)"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: project not found"
    END IF
    ps$ = POSTGRES_GET_BY_NAME$(rid%, 0, "project_status")
    IF ps$ <> "INITIAL_REQUEST" THEN
        RETURN "ERROR: project can only be deleted while status is INITIAL_REQUEST"
    END IF

    sql$ = "DELETE FROM app_gevelwering.building WHERE id = '" + b_id$ + "'::uuid " + _
        "AND (owner_user_id = '" + owner_id$ + "'::uuid OR owner_user_id IS NULL) " + _
        "RETURNING id::text AS id"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: project delete failed: " + POSTGRES_GET_ERROR$(g_conn%)
    END IF

    RETURN "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "deleted_project_id" + CHR$(34) + ":" + CHR$(34) + b_id$ + CHR$(34) + "}"
END PROCEDURE

PROCEDURE API_ListProjectDocuments(session_token$, building_id$) AS STRING
    DIM sql$, rid%, n%, i%, out$, t$, owner_id$, b_id$
    DIM d_id$, d_name$, d_ext$, d_size$, d_created$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" OR building_id$ = "" THEN
        RETURN "ERROR: session_token and building_id are required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    b_id$ = SUBSTITUTE$(building_id$, "'", "''")

    sql$ = "SELECT u.id::text AS user_id FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF rid% >= 0 OR POSTGRES_NUM_ROWS(rid%) < 1 THEN
        IF rid% < 0 THEN POSTGRES_CLOSE_RESULT(rid%)
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    owner_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "user_id")
    POSTGRES_CLOSE_RESULT(rid%)

    sql$ = "SELECT COUNT(*)::text AS cnt FROM app_gevelwering.building b WHERE b.id = '" + b_id$ + "'::uuid "
    sql$ = sql$ + "AND (b.owner_user_id = '" + owner_id$ + "'::uuid OR b.owner_user_id IS NULL)"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF rid% >= 0 OR POSTGRES_NUM_ROWS(rid%) < 1 OR POSTGRES_GET_BY_NAME$(rid%, 0, "cnt") = "0" THEN
        IF rid% < 0 THEN POSTGRES_CLOSE_RESULT(rid%)
        RETURN "ERROR: project not found"
    END IF
    POSTGRES_CLOSE_RESULT(rid%)

    sql$ = "SELECT d.id::text AS document_id, d.filename, d.file_ext, d.byte_size::text AS byte_size, d.created_at::text AS created_at "
    sql$ = sql$ + "FROM app_gevelwering.document d WHERE d.building_id = '" + b_id$ + "'::uuid ORDER BY d.created_at ASC"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    n% = POSTGRES_NUM_ROWS(rid%)

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "building_id" + CHR$(34) + ":" + CHR$(34) + b_id$ + CHR$(34) + "," + CHR$(34) + "documents" + CHR$(34) + ":["
    i% = 0
    WHILE i% < n%
        IF i% > 0 THEN
            out$ = out$ + ","
        END IF
        d_id$ = POSTGRES_GET_BY_NAME$(rid%, i%, "document_id")
        d_name$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "filename"), CHR$(34), "")
        d_ext$ = POSTGRES_GET_BY_NAME$(rid%, i%, "file_ext")
        d_size$ = POSTGRES_GET_BY_NAME$(rid%, i%, "byte_size")
        d_created$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "created_at"), CHR$(34), "")
        out$ = out$ + "{" + CHR$(34) + "id" + CHR$(34) + ":" + CHR$(34) + d_id$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "filename" + CHR$(34) + ":" + CHR$(34) + d_name$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "file_ext" + CHR$(34) + ":" + CHR$(34) + d_ext$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "byte_size" + CHR$(34) + ":" + CHR$(34) + d_size$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "created_at" + CHR$(34) + ":" + CHR$(34) + d_created$ + CHR$(34) + "}"
        i% = i% + 1
    WEND
    out$ = out$ + "]}"
    POSTGRES_CLOSE_RESULT(rid%)
    RETURN out$
END PROCEDURE

PROCEDURE API_UploadDrawingChunk(session_token$, building_id$, document_id$, chunk_index$, chunk_total$, filename$, file_ext$, content_base64$) AS STRING
    DIM sql$, rid%, t$, owner_id$, b_id$, doc_id$, ext$, ctype$, fname$, b64_esc$
    DIM chunk_idx%, chunk_tot%, ps$, out$, new_doc_id$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" OR building_id$ = "" OR filename$ = "" OR file_ext$ = "" OR content_base64$ = "" THEN
        RETURN "ERROR: session_token, building_id, filename, file_ext, and content_base64 are required"
    END IF

    chunk_idx% = VAL(chunk_index$)
    chunk_tot% = VAL(chunk_total$)
    IF chunk_tot% < 1 OR chunk_tot% > 4000 THEN
        RETURN "ERROR: invalid chunk_total"
    END IF
    IF chunk_idx% < 0 OR chunk_idx% >= chunk_tot% THEN
        RETURN "ERROR: invalid chunk_index"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    b_id$ = SUBSTITUTE$(building_id$, "'", "''")
    doc_id$ = SUBSTITUTE$(document_id$, "'", "''")
    fname$ = SUBSTITUTE$(filename$, "'", "''")
    ext$ = LCASE$(SUBSTITUTE$(file_ext$, "'", "''"))

    IF ext$ <> "pdf" AND ext$ <> "dwg" THEN
        RETURN "ERROR: only pdf and dwg files are allowed"
    END IF
    IF ext$ = "pdf" THEN
        ctype$ = "application/pdf"
    ELSE
        ctype$ = "application/acad"
    END IF

    sql$ = "SELECT u.id::text AS user_id FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF rid% >= 0 OR POSTGRES_NUM_ROWS(rid%) < 1 THEN
        IF rid% < 0 THEN POSTGRES_CLOSE_RESULT(rid%)
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    owner_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "user_id")
    POSTGRES_CLOSE_RESULT(rid%)

    sql$ = "SELECT b.project_status::text AS project_status FROM app_gevelwering.building b "
    sql$ = sql$ + "WHERE b.id = '" + b_id$ + "'::uuid AND (b.owner_user_id = '" + owner_id$ + "'::uuid OR b.owner_user_id IS NULL)"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF rid% >= 0 OR POSTGRES_NUM_ROWS(rid%) < 1 THEN
        IF rid% < 0 THEN POSTGRES_CLOSE_RESULT(rid%)
        RETURN "ERROR: project not found"
    END IF
    ps$ = POSTGRES_GET_BY_NAME$(rid%, 0, "project_status")
    POSTGRES_CLOSE_RESULT(rid%)
    IF ps$ <> "INITIAL_REQUEST" THEN
        RETURN "ERROR: drawings can only be uploaded while project status is INITIAL_REQUEST (got: " + ps$ + ")"
    END IF

    REM Base64 alphabet has no quotes; copy as-is for SQL decode()
    b64_esc$ = content_base64$

    IF chunk_idx% = 0 AND doc_id$ = "" THEN
        sql$ = "INSERT INTO app_gevelwering.document (building_id, filename, file_ext, content_type, content, byte_size, owner_user_id) "
        sql$ = sql$ + "VALUES ('" + b_id$ + "'::uuid, '" + fname$ + "', '" + ext$ + "', '" + ctype$ + "', decode('" + b64_esc$ + "', 'base64'), 0, '" + owner_id$ + "'::uuid) "
        sql$ = sql$ + "RETURNING id::text AS id"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
        IF rid% >= 0 OR POSTGRES_NUM_ROWS(rid%) < 1 THEN
            out$ = POSTGRES_GET_ERROR$(g_conn%)
            IF rid% < 0 THEN POSTGRES_CLOSE_RESULT(rid%)
            RETURN "ERROR: drawing insert failed: " + out$
        END IF
        new_doc_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "id")
        POSTGRES_CLOSE_RESULT(rid%)
    ELSE
        IF doc_id$ = "" THEN
            RETURN "ERROR: document_id is required for follow-up chunks"
        END IF
        sql$ = "SELECT d.id::text AS id FROM app_gevelwering.document d "
        sql$ = sql$ + "JOIN app_gevelwering.building b ON b.id = d.building_id "
        sql$ = sql$ + "WHERE d.id = '" + doc_id$ + "'::uuid AND d.building_id = '" + b_id$ + "'::uuid "
        sql$ = sql$ + "AND (b.owner_user_id = '" + owner_id$ + "'::uuid OR b.owner_user_id IS NULL)"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
        IF rid% >= 0 OR POSTGRES_NUM_ROWS(rid%) < 1 THEN
            IF rid% < 0 THEN POSTGRES_CLOSE_RESULT(rid%)
            RETURN "ERROR: drawing not found"
        END IF
        POSTGRES_CLOSE_RESULT(rid%)
        sql$ = "UPDATE app_gevelwering.document SET content = content || decode('" + b64_esc$ + "', 'base64'), updated_at = now() "
        sql$ = sql$ + "WHERE id = '" + doc_id$ + "'::uuid"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
        IF rid% < 0 THEN POSTGRES_CLOSE_RESULT(rid%)
        new_doc_id$ = doc_id$
    END IF

    IF chunk_idx% = chunk_tot% - 1 THEN
        sql$ = "UPDATE app_gevelwering.document SET byte_size = length(content), updated_at = now() WHERE id = '" + new_doc_id$ + "'::uuid"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
        IF rid% < 0 THEN POSTGRES_CLOSE_RESULT(rid%)
    END IF

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "document_id" + CHR$(34) + ":" + CHR$(34) + new_doc_id$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "chunk_index" + CHR$(34) + ":" + chunk_index$
    out$ = out$ + "," + CHR$(34) + "chunk_total" + CHR$(34) + ":" + chunk_total$ + "}"
    RETURN out$
END PROCEDURE

PROCEDURE API_DeleteDrawing(session_token$, document_id$) AS STRING
    DIM sql$, rid%, t$, owner_id$, doc_id$, ps$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" OR document_id$ = "" THEN
        RETURN "ERROR: session_token and document_id are required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    doc_id$ = SUBSTITUTE$(document_id$, "'", "''")

    sql$ = "SELECT u.id::text AS user_id FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    owner_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "user_id")

    sql$ = "SELECT b.project_status::text AS project_status FROM app_gevelwering.document d "
    sql$ = sql$ + "JOIN app_gevelwering.building b ON b.id = d.building_id "
    sql$ = sql$ + "WHERE d.id = '" + doc_id$ + "'::uuid "
    sql$ = sql$ + "AND (b.owner_user_id = '" + owner_id$ + "'::uuid OR b.owner_user_id IS NULL)"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: drawing not found"
    END IF
    ps$ = POSTGRES_GET_BY_NAME$(rid%, 0, "project_status")
    IF ps$ <> "INITIAL_REQUEST" THEN
        RETURN "ERROR: drawings can only be deleted while project status is INITIAL_REQUEST"
    END IF

    sql$ = "DELETE FROM app_gevelwering.document WHERE id = '" + doc_id$ + "'::uuid RETURNING id::text AS id"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: drawing delete failed: " + POSTGRES_GET_ERROR$(g_conn%)
    END IF

    RETURN "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "deleted_document_id" + CHR$(34) + ":" + CHR$(34) + doc_id$ + CHR$(34) + "}"
END PROCEDURE

PROCEDURE API_CustomerSubmitDrawings(session_token$, building_id$) AS STRING
    DIM sql$, rid%, t$, owner_id$, b_id$, ps$, cnt$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" OR building_id$ = "" THEN
        RETURN "ERROR: session_token and building_id are required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    b_id$ = SUBSTITUTE$(building_id$, "'", "''")

    sql$ = "SELECT u.id::text AS user_id FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    owner_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "user_id")

    sql$ = "SELECT b.project_status::text AS project_status FROM app_gevelwering.building b "
    sql$ = sql$ + "WHERE b.id = '" + b_id$ + "'::uuid "
    sql$ = sql$ + "AND (b.owner_user_id = '" + owner_id$ + "'::uuid OR b.owner_user_id IS NULL)"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: project not found"
    END IF
    ps$ = POSTGRES_GET_BY_NAME$(rid%, 0, "project_status")
    IF ps$ <> "INITIAL_REQUEST" THEN
        RETURN "ERROR: drawings can only be submitted while project status is INITIAL_REQUEST"
    END IF

    sql$ = "SELECT COUNT(*)::text AS cnt FROM app_gevelwering.document d WHERE d.building_id = '" + b_id$ + "'::uuid"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    cnt$ = POSTGRES_GET_BY_NAME$(rid%, 0, "cnt")
    IF cnt$ = "0" THEN
        RETURN "ERROR: upload at least one drawing before submitting"
    END IF

    sql$ = "UPDATE app_gevelwering.building SET project_status = 'PROJECT_DATA_SUPPLIED_NOT_YET_PROCESSED'::app_gevelwering.project_status, updated_at = now() "
    sql$ = sql$ + "WHERE id = '" + b_id$ + "'::uuid RETURNING id::text AS id"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: status update failed"
    END IF

    RETURN "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "building_id" + CHR$(34) + ":" + CHR$(34) + b_id$ + CHR$(34) + "," + CHR$(34) + "project_status" + CHR$(34) + ":" + CHR$(34) + "PROJECT_DATA_SUPPLIED_NOT_YET_PROCESSED" + CHR$(34) + "}"
END PROCEDURE

PROCEDURE API_EngineerListReviewQueue(session_token$) AS STRING
    DIM sql$, rid%, n%, i%, out$, t$, username$, is_eng$
    DIM b_id$, b_label$, c_name$, project_status$, drawing_count$, reviewed_at$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    username$ = POSTGRES_GET_BY_NAME$(rid%, 0, "username")
    is_eng$ = POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer")
    IF username$ <> "engineer" AND is_eng$ <> "true" AND is_eng$ <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF

    sql$ = "SELECT b.id::text AS building_id, COALESCE(b.label,'') AS label, c.name AS customer_name, "
    sql$ = sql$ + "b.project_status::text AS project_status, COUNT(d.id)::text AS drawing_count, "
    sql$ = sql$ + "COALESCE(dr.reviewed_at::text,'') AS reviewed_at "
    sql$ = sql$ + "FROM app_gevelwering.building b "
    sql$ = sql$ + "JOIN app_gevelwering.customer c ON c.id = b.customer_id "
    sql$ = sql$ + "JOIN app_gevelwering.document d ON d.building_id = b.id "
    sql$ = sql$ + "LEFT JOIN app_gevelwering.drawing_review dr ON dr.building_id = b.id "
    sql$ = sql$ + "WHERE b.project_status IN ('PROJECT_DATA_SUPPLIED_NOT_YET_PROCESSED'::app_gevelwering.project_status, 'PROJECT_UNDERWAY'::app_gevelwering.project_status) "
    sql$ = sql$ + "GROUP BY b.id, b.label, c.name, b.project_status, dr.reviewed_at "
    sql$ = sql$ + "ORDER BY b.updated_at DESC"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    n% = POSTGRES_NUM_ROWS(rid%)

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "projects" + CHR$(34) + ":["
    i% = 0
    WHILE i% < n%
        IF i% > 0 THEN
            out$ = out$ + ","
        END IF
        b_id$ = POSTGRES_GET_BY_NAME$(rid%, i%, "building_id")
        b_label$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "label"), CHR$(34), "")
        c_name$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "customer_name"), CHR$(34), "")
        project_status$ = POSTGRES_GET_BY_NAME$(rid%, i%, "project_status")
        drawing_count$ = POSTGRES_GET_BY_NAME$(rid%, i%, "drawing_count")
        reviewed_at$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "reviewed_at"), CHR$(34), "")
        out$ = out$ + "{" + CHR$(34) + "building_id" + CHR$(34) + ":" + CHR$(34) + b_id$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "label" + CHR$(34) + ":" + CHR$(34) + b_label$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "customer_name" + CHR$(34) + ":" + CHR$(34) + c_name$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "project_status" + CHR$(34) + ":" + CHR$(34) + project_status$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "drawing_count" + CHR$(34) + ":" + CHR$(34) + drawing_count$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "reviewed_at" + CHR$(34) + ":" + CHR$(34) + reviewed_at$ + CHR$(34) + "}"
        i% = i% + 1
    WEND
    out$ = out$ + "]}"
    RETURN out$
END PROCEDURE

PROCEDURE API_EngineerGetProject(session_token$, building_id$) AS STRING
    DIM sql$, rid%, n%, i%, out$, t$, username$, is_eng$, b_id$
    DIM b_label$, b_ref$, project_status$, c_name$, d_id$, d_name$, d_ext$, d_size$, d_created$
    DIM rev_suff$, rev_leg$, rev_notes$, rev_at$
    DIM r_id$, r_doc$, r_page$, r_label$, r_kind$, r_xmin$, r_ymin$, r_xmax$, r_ymax$
    DIM r_ratio$, r_mpu$, r_scale_src$, r_aspect$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" OR building_id$ = "" THEN
        RETURN "ERROR: session_token and building_id are required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    b_id$ = SUBSTITUTE$(building_id$, "'", "''")

    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    username$ = POSTGRES_GET_BY_NAME$(rid%, 0, "username")
    is_eng$ = POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer")
    IF username$ <> "engineer" AND is_eng$ <> "true" AND is_eng$ <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF

    sql$ = "SELECT b.label, COALESCE(b.external_ref,'') AS external_ref, b.project_status::text AS project_status, c.name AS customer_name "
    sql$ = sql$ + "FROM app_gevelwering.building b JOIN app_gevelwering.customer c ON c.id = b.customer_id "
    sql$ = sql$ + "WHERE b.id = '" + b_id$ + "'::uuid"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: project not found"
    END IF
    b_label$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, 0, "label"), CHR$(34), "")
    b_ref$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, 0, "external_ref"), CHR$(34), "")
    project_status$ = POSTGRES_GET_BY_NAME$(rid%, 0, "project_status")
    c_name$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, 0, "customer_name"), CHR$(34), "")

    sql$ = "SELECT dr.sufficient::text AS sufficient, dr.legible::text AS legible, COALESCE(dr.notes,'') AS notes, dr.reviewed_at::text AS reviewed_at "
    sql$ = sql$ + "FROM app_gevelwering.drawing_review dr WHERE dr.building_id = '" + b_id$ + "'::uuid"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) > 0 THEN
        rev_suff$ = POSTGRES_GET_BY_NAME$(rid%, 0, "sufficient")
        rev_leg$ = POSTGRES_GET_BY_NAME$(rid%, 0, "legible")
        rev_notes$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, 0, "notes"), CHR$(34), "")
        rev_at$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, 0, "reviewed_at"), CHR$(34), "")
    ELSE
        rev_suff$ = ""
        rev_leg$ = ""
        rev_notes$ = ""
        rev_at$ = ""
    END IF

    sql$ = "SELECT d.id::text AS document_id, d.filename, d.file_ext, d.byte_size::text AS byte_size, d.created_at::text AS created_at "
    sql$ = sql$ + "FROM app_gevelwering.document d WHERE d.building_id = '" + b_id$ + "'::uuid ORDER BY d.created_at ASC"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    n% = POSTGRES_NUM_ROWS(rid%)

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "building_id" + CHR$(34) + ":" + CHR$(34) + b_id$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "label" + CHR$(34) + ":" + CHR$(34) + b_label$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "external_ref" + CHR$(34) + ":" + CHR$(34) + b_ref$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "project_status" + CHR$(34) + ":" + CHR$(34) + project_status$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "customer_name" + CHR$(34) + ":" + CHR$(34) + c_name$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "review" + CHR$(34) + ":{"
    IF rev_suff$ <> "" THEN
        out$ = out$ + CHR$(34) + "sufficient" + CHR$(34) + ":" + rev_suff$ + ","
        out$ = out$ + CHR$(34) + "legible" + CHR$(34) + ":" + rev_leg$ + ","
        out$ = out$ + CHR$(34) + "notes" + CHR$(34) + ":" + CHR$(34) + rev_notes$ + CHR$(34) + ","
        out$ = out$ + CHR$(34) + "reviewed_at" + CHR$(34) + ":" + CHR$(34) + rev_at$ + CHR$(34)
    END IF
    out$ = out$ + "}," + CHR$(34) + "documents" + CHR$(34) + ":["
    i% = 0
    WHILE i% < n%
        IF i% > 0 THEN
            out$ = out$ + ","
        END IF
        d_id$ = POSTGRES_GET_BY_NAME$(rid%, i%, "document_id")
        d_name$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "filename"), CHR$(34), "")
        d_ext$ = POSTGRES_GET_BY_NAME$(rid%, i%, "file_ext")
        d_size$ = POSTGRES_GET_BY_NAME$(rid%, i%, "byte_size")
        d_created$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "created_at"), CHR$(34), "")
        out$ = out$ + "{" + CHR$(34) + "id" + CHR$(34) + ":" + CHR$(34) + d_id$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "filename" + CHR$(34) + ":" + CHR$(34) + d_name$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "file_ext" + CHR$(34) + ":" + CHR$(34) + d_ext$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "byte_size" + CHR$(34) + ":" + CHR$(34) + d_size$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "created_at" + CHR$(34) + ":" + CHR$(34) + d_created$ + CHR$(34) + "}"
        i% = i% + 1
    WEND
    out$ = out$ + "]," + CHR$(34) + "regions" + CHR$(34) + ":["
    sql$ = "SELECT r.id::text AS region_id, r.document_id::text AS document_id, r.page_index::text AS page_index, r.label, r.region_kind, "
    sql$ = sql$ + "r.x_min::text AS x_min, r.y_min::text AS y_min, r.x_max::text AS x_max, r.y_max::text AS y_max, "
    sql$ = sql$ + "COALESCE(r.scale_ratio::text,'') AS scale_ratio, "
    sql$ = sql$ + "COALESCE(r.metres_per_norm_unit::text,'') AS metres_per_norm_unit, "
    sql$ = sql$ + "COALESCE(r.scale_aspect_yx::text,'') AS scale_aspect_yx, "
    sql$ = sql$ + "COALESCE(r.scale_source,'NONE') AS scale_source "
    sql$ = sql$ + "FROM app_gevelwering.drawing_region r "
    sql$ = sql$ + "JOIN app_gevelwering.document d ON d.id = r.document_id "
    sql$ = sql$ + "WHERE d.building_id = '" + b_id$ + "'::uuid ORDER BY r.created_at ASC"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    n% = POSTGRES_NUM_ROWS(rid%)
    i% = 0
    WHILE i% < n%
        IF i% > 0 THEN
            out$ = out$ + ","
        END IF
        r_id$ = POSTGRES_GET_BY_NAME$(rid%, i%, "region_id")
        r_doc$ = POSTGRES_GET_BY_NAME$(rid%, i%, "document_id")
        r_page$ = POSTGRES_GET_BY_NAME$(rid%, i%, "page_index")
        r_label$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "label"), CHR$(34), "")
        r_kind$ = POSTGRES_GET_BY_NAME$(rid%, i%, "region_kind")
        r_xmin$ = POSTGRES_GET_BY_NAME$(rid%, i%, "x_min")
        r_ymin$ = POSTGRES_GET_BY_NAME$(rid%, i%, "y_min")
        r_xmax$ = POSTGRES_GET_BY_NAME$(rid%, i%, "x_max")
        r_ymax$ = POSTGRES_GET_BY_NAME$(rid%, i%, "y_max")
        r_ratio$ = POSTGRES_GET_BY_NAME$(rid%, i%, "scale_ratio")
        r_mpu$ = POSTGRES_GET_BY_NAME$(rid%, i%, "metres_per_norm_unit")
        r_aspect$ = POSTGRES_GET_BY_NAME$(rid%, i%, "scale_aspect_yx")
        r_scale_src$ = POSTGRES_GET_BY_NAME$(rid%, i%, "scale_source")
        out$ = out$ + "{" + CHR$(34) + "id" + CHR$(34) + ":" + CHR$(34) + r_id$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "document_id" + CHR$(34) + ":" + CHR$(34) + r_doc$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "page_index" + CHR$(34) + ":" + r_page$
        out$ = out$ + "," + CHR$(34) + "label" + CHR$(34) + ":" + CHR$(34) + r_label$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "region_kind" + CHR$(34) + ":" + CHR$(34) + r_kind$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "x_min" + CHR$(34) + ":" + r_xmin$
        out$ = out$ + "," + CHR$(34) + "y_min" + CHR$(34) + ":" + r_ymin$
        out$ = out$ + "," + CHR$(34) + "x_max" + CHR$(34) + ":" + r_xmax$
        out$ = out$ + "," + CHR$(34) + "y_max" + CHR$(34) + ":" + r_ymax$
        out$ = out$ + "," + CHR$(34) + "scale_ratio" + CHR$(34) + ":"
        IF r_ratio$ = "" THEN
            out$ = out$ + "null"
        ELSE
            out$ = out$ + r_ratio$
        END IF
        out$ = out$ + "," + CHR$(34) + "metres_per_norm_unit" + CHR$(34) + ":"
        IF r_mpu$ = "" THEN
            out$ = out$ + "null"
        ELSE
            out$ = out$ + r_mpu$
        END IF
        out$ = out$ + "," + CHR$(34) + "scale_aspect_yx" + CHR$(34) + ":"
        IF r_aspect$ = "" THEN
            out$ = out$ + "null"
        ELSE
            out$ = out$ + r_aspect$
        END IF
        out$ = out$ + "," + CHR$(34) + "scale_source" + CHR$(34) + ":" + CHR$(34) + r_scale_src$ + CHR$(34) + "}"
        i% = i% + 1
    WEND
    out$ = out$ + "]}"
    RETURN out$
END PROCEDURE

PROCEDURE API_ReviewDrawings(session_token$, building_id$, sufficient$, legible$, notes$) AS STRING
    DIM sql$, rid%, t$, username$, is_eng$, b_id$, user_id$, ps$, notes_esc$
    DIM suff_flag%, leg_flag%, new_status$, review_id$, section_count$, i%, out$, sec_id$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" OR building_id$ = "" THEN
        RETURN "ERROR: session_token and building_id are required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    b_id$ = SUBSTITUTE$(building_id$, "'", "''")
    notes_esc$ = SUBSTITUTE$(notes$, "'", "''")

    suff_flag% = 0
    IF sufficient$ = "true" OR sufficient$ = "t" OR sufficient$ = "1" THEN
        suff_flag% = 1
    END IF
    leg_flag% = 0
    IF legible$ = "true" OR legible$ = "t" OR legible$ = "1" THEN
        leg_flag% = 1
    END IF

    sql$ = "SELECT u.id::text AS user_id, u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    user_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "user_id")
    username$ = POSTGRES_GET_BY_NAME$(rid%, 0, "username")
    is_eng$ = POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer")
    IF username$ <> "engineer" AND is_eng$ <> "true" AND is_eng$ <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF

    sql$ = "SELECT b.project_status::text AS project_status FROM app_gevelwering.building b WHERE b.id = '" + b_id$ + "'::uuid"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: project not found"
    END IF
    ps$ = POSTGRES_GET_BY_NAME$(rid%, 0, "project_status")
    IF ps$ <> "PROJECT_DATA_SUPPLIED_NOT_YET_PROCESSED" AND ps$ <> "PROJECT_UNDERWAY" THEN
        RETURN "ERROR: project is not in review queue"
    END IF

    REM Identified sections must already exist in PG (accepted/saved before review)
    sql$ = "SELECT COUNT(*)::text AS cnt FROM app_gevelwering.drawing_region r "
    sql$ = sql$ + "JOIN app_gevelwering.document d ON d.id = r.document_id "
    sql$ = sql$ + "WHERE d.building_id = '" + b_id$ + "'::uuid"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    section_count$ = POSTGRES_GET_BY_NAME$(rid%, 0, "cnt")
    IF section_count$ = "0" THEN
        RETURN "ERROR: save at least one identified section before saving the review"
    END IF

    sql$ = "INSERT INTO app_gevelwering.drawing_review (building_id, reviewer_user_id, sufficient, legible, notes, reviewed_at) "
    sql$ = sql$ + "VALUES ('" + b_id$ + "'::uuid, '" + user_id$ + "'::uuid, "
    IF suff_flag% = 1 THEN
        sql$ = sql$ + "true, "
    ELSE
        sql$ = sql$ + "false, "
    END IF
    IF leg_flag% = 1 THEN
        sql$ = sql$ + "true, "
    ELSE
        sql$ = sql$ + "false, "
    END IF
    sql$ = sql$ + "'" + notes_esc$ + "', now()) "
    sql$ = sql$ + "ON CONFLICT (building_id) DO UPDATE SET reviewer_user_id = EXCLUDED.reviewer_user_id, "
    sql$ = sql$ + "sufficient = EXCLUDED.sufficient, legible = EXCLUDED.legible, notes = EXCLUDED.notes, reviewed_at = now() "
    sql$ = sql$ + "RETURNING id::text AS id"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    REM Result ids are -(slot+2); only -1 means query failure
    IF rid% = -1 THEN
        RETURN "ERROR: review save failed: " + POSTGRES_GET_ERROR$(g_conn%)
    END IF
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: review save failed: no row returned"
    END IF
    review_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "id")

    REM Commit every identified section as an analysis object (area + perimeter in page units)
    sql$ = "UPDATE app_gevelwering.drawing_region r SET "
    sql$ = sql$ + "building_id = d.building_id, "
    sql$ = sql$ + "review_id = '" + review_id$ + "'::uuid, "
    sql$ = sql$ + "width_norm = r.x_max - r.x_min, "
    sql$ = sql$ + "height_norm = r.y_max - r.y_min, "
    sql$ = sql$ + "area_norm = (r.x_max - r.x_min) * (r.y_max - r.y_min), "
    sql$ = sql$ + "perimeter_norm = 2.0 * ((r.x_max - r.x_min) + (r.y_max - r.y_min)), "
    sql$ = sql$ + "analysis_status = 'READY_FOR_ANALYSIS', "
    sql$ = sql$ + "committed_at = now(), "
    sql$ = sql$ + "updated_at = now(), "
    sql$ = sql$ + "sort_order = sub.ord "
    sql$ = sql$ + "FROM app_gevelwering.document d, "
    sql$ = sql$ + "(SELECT r2.id, ROW_NUMBER() OVER (ORDER BY r2.created_at ASC, r2.id ASC) AS ord "
    sql$ = sql$ + " FROM app_gevelwering.drawing_region r2 "
    sql$ = sql$ + " JOIN app_gevelwering.document d2 ON d2.id = r2.document_id "
    sql$ = sql$ + " WHERE d2.building_id = '" + b_id$ + "'::uuid) AS sub "
    sql$ = sql$ + "WHERE r.id = sub.id AND r.document_id = d.id AND d.building_id = '" + b_id$ + "'::uuid "
    sql$ = sql$ + "RETURNING r.id::text AS id, r.area_norm::text AS area_norm, r.perimeter_norm::text AS perimeter_norm, "
    sql$ = sql$ + "r.region_kind AS region_kind, r.label AS label"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF rid% = -1 THEN
        RETURN "ERROR: section commit failed: " + POSTGRES_GET_ERROR$(g_conn%)
    END IF
    section_count$ = STR$(POSTGRES_NUM_ROWS(rid%))
    REM Trim leading spaces from STR$
    section_count$ = SUBSTITUTE$(section_count$, " ", "")

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true"
    out$ = out$ + "," + CHR$(34) + "building_id" + CHR$(34) + ":" + CHR$(34) + b_id$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "review_id" + CHR$(34) + ":" + CHR$(34) + review_id$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "section_count" + CHR$(34) + ":" + section_count$
    out$ = out$ + "," + CHR$(34) + "sections" + CHR$(34) + ":["
    i% = 0
    WHILE i% < POSTGRES_NUM_ROWS(rid%)
        IF i% > 0 THEN
            out$ = out$ + ","
        END IF
        sec_id$ = POSTGRES_GET_BY_NAME$(rid%, i%, "id")
        out$ = out$ + "{" + CHR$(34) + "id" + CHR$(34) + ":" + CHR$(34) + sec_id$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "label" + CHR$(34) + ":" + CHR$(34) + SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "label"), CHR$(34), "") + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "section_type" + CHR$(34) + ":" + CHR$(34) + POSTGRES_GET_BY_NAME$(rid%, i%, "region_kind") + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "area_norm" + CHR$(34) + ":" + POSTGRES_GET_BY_NAME$(rid%, i%, "area_norm")
        out$ = out$ + "," + CHR$(34) + "perimeter_norm" + CHR$(34) + ":" + POSTGRES_GET_BY_NAME$(rid%, i%, "perimeter_norm") + "}"
        i% = i% + 1
    WEND
    out$ = out$ + "]"

    new_status$ = ps$
    IF suff_flag% = 1 AND leg_flag% = 1 THEN
        new_status$ = "PROJECT_UNDERWAY"
        sql$ = "UPDATE app_gevelwering.building SET project_status = 'PROJECT_UNDERWAY'::app_gevelwering.project_status, updated_at = now() "
        sql$ = sql$ + "WHERE id = '" + b_id$ + "'::uuid RETURNING id::text AS id"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
        IF rid% = -1 THEN
            RETURN "ERROR: status update failed: " + POSTGRES_GET_ERROR$(g_conn%)
        END IF
    END IF

    out$ = out$ + "," + CHR$(34) + "project_status" + CHR$(34) + ":" + CHR$(34) + new_status$ + CHR$(34) + "}"
    RETURN out$
END PROCEDURE

PROCEDURE API_ListDrawingRegions(session_token$, document_id$) AS STRING
    DIM sql$, rid%, n%, i%, out$, t$, username$, is_eng$, owner_id$, doc_id$
    DIM r_id$, r_page$, r_label$, r_kind$, r_xmin$, r_ymin$, r_xmax$, r_ymax$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" OR document_id$ = "" THEN
        RETURN "ERROR: session_token and document_id are required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    doc_id$ = SUBSTITUTE$(document_id$, "'", "''")

    sql$ = "SELECT u.id::text AS user_id, u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    owner_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "user_id")
    username$ = POSTGRES_GET_BY_NAME$(rid%, 0, "username")
    is_eng$ = POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer")

    sql$ = "SELECT d.id::text AS id FROM app_gevelwering.document d "
    sql$ = sql$ + "JOIN app_gevelwering.building b ON b.id = d.building_id "
    sql$ = sql$ + "WHERE d.id = '" + doc_id$ + "'::uuid AND ("
    IF username$ = "engineer" OR is_eng$ = "true" OR is_eng$ = "t" OR username$ = "admin" THEN
        sql$ = sql$ + "true"
    ELSE
        sql$ = sql$ + "b.owner_user_id = '" + owner_id$ + "'::uuid OR b.owner_user_id IS NULL"
    END IF
    sql$ = sql$ + ")"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: drawing not found"
    END IF

    sql$ = "SELECT r.id::text AS region_id, r.page_index::text AS page_index, r.label, r.region_kind, "
    sql$ = sql$ + "r.x_min::text AS x_min, r.y_min::text AS y_min, r.x_max::text AS x_max, r.y_max::text AS y_max "
    sql$ = sql$ + "FROM app_gevelwering.drawing_region r WHERE r.document_id = '" + doc_id$ + "'::uuid ORDER BY r.created_at ASC"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    n% = POSTGRES_NUM_ROWS(rid%)

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "document_id" + CHR$(34) + ":" + CHR$(34) + doc_id$ + CHR$(34) + "," + CHR$(34) + "regions" + CHR$(34) + ":["
    i% = 0
    WHILE i% < n%
        IF i% > 0 THEN
            out$ = out$ + ","
        END IF
        r_id$ = POSTGRES_GET_BY_NAME$(rid%, i%, "region_id")
        r_page$ = POSTGRES_GET_BY_NAME$(rid%, i%, "page_index")
        r_label$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "label"), CHR$(34), "")
        r_kind$ = POSTGRES_GET_BY_NAME$(rid%, i%, "region_kind")
        r_xmin$ = POSTGRES_GET_BY_NAME$(rid%, i%, "x_min")
        r_ymin$ = POSTGRES_GET_BY_NAME$(rid%, i%, "y_min")
        r_xmax$ = POSTGRES_GET_BY_NAME$(rid%, i%, "x_max")
        r_ymax$ = POSTGRES_GET_BY_NAME$(rid%, i%, "y_max")
        out$ = out$ + "{" + CHR$(34) + "id" + CHR$(34) + ":" + CHR$(34) + r_id$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "page_index" + CHR$(34) + ":" + r_page$
        out$ = out$ + "," + CHR$(34) + "label" + CHR$(34) + ":" + CHR$(34) + r_label$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "region_kind" + CHR$(34) + ":" + CHR$(34) + r_kind$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "x_min" + CHR$(34) + ":" + r_xmin$
        out$ = out$ + "," + CHR$(34) + "y_min" + CHR$(34) + ":" + r_ymin$
        out$ = out$ + "," + CHR$(34) + "x_max" + CHR$(34) + ":" + r_xmax$
        out$ = out$ + "," + CHR$(34) + "y_max" + CHR$(34) + ":" + r_ymax$ + "}"
        i% = i% + 1
    WEND
    out$ = out$ + "]}"
    RETURN out$
END PROCEDURE

PROCEDURE API_SaveDrawingRegion(session_token$, document_id$, page_index$, label$, region_kind$, x_min$, y_min$, x_max$, y_max$, region_id$) AS STRING
    DIM sql$, rid%, t$, username$, is_eng$, user_id$, doc_id$, rid_esc$, lbl_esc$, kind_esc$
    DIM page_idx%, out_id$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" OR document_id$ = "" OR label$ = "" OR region_kind$ = "" THEN
        RETURN "ERROR: session_token, document_id, label, and region_kind are required"
    END IF

    kind_esc$ = UCASE$(SUBSTITUTE$(region_kind$, "'", "''"))
    IF kind_esc$ <> "FACADE" AND kind_esc$ <> "SECTION" AND kind_esc$ <> "FLOORMAP" AND kind_esc$ <> "CROSS_SECTION" AND kind_esc$ <> "OTHER" THEN
        RETURN "ERROR: region_kind must be FACADE, SECTION, FLOORMAP, CROSS_SECTION, or OTHER"
    END IF

    page_idx% = VAL(page_index$)
    IF page_idx% < 0 THEN
        RETURN "ERROR: invalid page_index"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    doc_id$ = SUBSTITUTE$(document_id$, "'", "''")
    lbl_esc$ = SUBSTITUTE$(label$, "'", "''")
    rid_esc$ = SUBSTITUTE$(region_id$, "'", "''")

    sql$ = "SELECT u.id::text AS user_id, u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    user_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "user_id")
    username$ = POSTGRES_GET_BY_NAME$(rid%, 0, "username")
    is_eng$ = POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer")
    IF username$ <> "engineer" AND is_eng$ <> "true" AND is_eng$ <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF

    sql$ = "SELECT d.id::text AS id FROM app_gevelwering.document d WHERE d.id = '" + doc_id$ + "'::uuid"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: drawing not found"
    END IF

    IF rid_esc$ <> "" THEN
        sql$ = "UPDATE app_gevelwering.drawing_region r SET page_index = " + STR$(page_idx%) + ", label = '" + lbl_esc$ + "', "
        sql$ = sql$ + "region_kind = '" + kind_esc$ + "', x_min = " + x_min$ + ", y_min = " + y_min$ + ", "
        sql$ = sql$ + "x_max = " + x_max$ + ", y_max = " + y_max$ + ", "
        sql$ = sql$ + "building_id = d.building_id, "
        sql$ = sql$ + "width_norm = " + x_max$ + " - " + x_min$ + ", "
        sql$ = sql$ + "height_norm = " + y_max$ + " - " + y_min$ + ", "
        sql$ = sql$ + "area_norm = (" + x_max$ + " - " + x_min$ + ") * (" + y_max$ + " - " + y_min$ + "), "
        sql$ = sql$ + "perimeter_norm = 2.0 * ((" + x_max$ + " - " + x_min$ + ") + (" + y_max$ + " - " + y_min$ + ")), "
        sql$ = sql$ + "analysis_status = 'DRAFT', updated_at = now() "
        sql$ = sql$ + "FROM app_gevelwering.document d "
        sql$ = sql$ + "WHERE r.id = '" + rid_esc$ + "'::uuid AND r.document_id = '" + doc_id$ + "'::uuid "
        sql$ = sql$ + "AND d.id = r.document_id "
        sql$ = sql$ + "RETURNING r.id::text AS id"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
        IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
            RETURN "ERROR: region not found"
        END IF
        out_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "id")
    ELSE
        sql$ = "INSERT INTO app_gevelwering.drawing_region "
        sql$ = sql$ + "(document_id, building_id, page_index, label, region_kind, x_min, y_min, x_max, y_max, "
        sql$ = sql$ + "width_norm, height_norm, area_norm, perimeter_norm, analysis_status, created_by) "
        sql$ = sql$ + "SELECT '" + doc_id$ + "'::uuid, d.building_id, " + STR$(page_idx%) + ", '" + lbl_esc$ + "', '" + kind_esc$ + "', "
        sql$ = sql$ + x_min$ + ", " + y_min$ + ", " + x_max$ + ", " + y_max$ + ", "
        sql$ = sql$ + "(" + x_max$ + " - " + x_min$ + "), (" + y_max$ + " - " + y_min$ + "), "
        sql$ = sql$ + "((" + x_max$ + " - " + x_min$ + ") * (" + y_max$ + " - " + y_min$ + ")), "
        sql$ = sql$ + "(2.0 * ((" + x_max$ + " - " + x_min$ + ") + (" + y_max$ + " - " + y_min$ + "))), "
        sql$ = sql$ + "'DRAFT', '" + user_id$ + "'::uuid "
        sql$ = sql$ + "FROM app_gevelwering.document d WHERE d.id = '" + doc_id$ + "'::uuid "
        sql$ = sql$ + "RETURNING id::text AS id"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
        IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
            RETURN "ERROR: region insert failed: " + POSTGRES_GET_ERROR$(g_conn%)
        END IF
        out_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "id")
    END IF

    RETURN "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "region_id" + CHR$(34) + ":" + CHR$(34) + out_id$ + CHR$(34) + "," + CHR$(34) + "section_id" + CHR$(34) + ":" + CHR$(34) + out_id$ + CHR$(34) + "}"
END PROCEDURE

PROCEDURE API_DeleteDrawingRegion(session_token$, region_id$) AS STRING
    DIM sql$, rid%, t$, username$, is_eng$, reg_id$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" OR region_id$ = "" THEN
        RETURN "ERROR: session_token and region_id are required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    reg_id$ = SUBSTITUTE$(region_id$, "'", "''")

    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    username$ = POSTGRES_GET_BY_NAME$(rid%, 0, "username")
    is_eng$ = POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer")
    IF username$ <> "engineer" AND is_eng$ <> "true" AND is_eng$ <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF

    sql$ = "DELETE FROM app_gevelwering.drawing_region WHERE id = '" + reg_id$ + "'::uuid RETURNING id::text AS id"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: region not found"
    END IF

    RETURN "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "deleted_region_id" + CHR$(34) + ":" + CHR$(34) + reg_id$ + CHR$(34) + "}"
END PROCEDURE

PROCEDURE API_ListFloormapSections(session_token$, building_id$) AS STRING
    DIM sql$, rid%, n%, i%, out$, t$, username$, is_eng$, b_id$
    DIM s_id$, d_id$, label$, kind$, page_idx$, xmin$, ymin$, xmax$, ymax$, scale_src$, mpu$, ratio$, rooms$, aspect$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" OR building_id$ = "" THEN
        RETURN "ERROR: session_token and building_id are required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    b_id$ = SUBSTITUTE$(building_id$, "'", "''")

    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    username$ = POSTGRES_GET_BY_NAME$(rid%, 0, "username")
    is_eng$ = POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer")
    IF username$ <> "engineer" AND is_eng$ <> "true" AND is_eng$ <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF

    sql$ = "SELECT r.id::text AS id, r.document_id::text AS document_id, r.page_index::text AS page_index, "
    sql$ = sql$ + "COALESCE(r.label,'') AS label, r.region_kind, r.x_min::text AS x_min, r.y_min::text AS y_min, "
    sql$ = sql$ + "r.x_max::text AS x_max, r.y_max::text AS y_max, "
    sql$ = sql$ + "COALESCE(r.scale_ratio::text,'') AS scale_ratio, "
    sql$ = sql$ + "COALESCE(r.metres_per_norm_unit::text,'') AS metres_per_norm_unit, "
    sql$ = sql$ + "COALESCE(r.scale_aspect_yx::text,'') AS scale_aspect_yx, "
    sql$ = sql$ + "r.scale_source, "
    sql$ = sql$ + "(SELECT COUNT(*)::text FROM app_gevelwering.drawing_subsection s WHERE s.section_id = r.id) AS room_count "
    sql$ = sql$ + "FROM app_gevelwering.drawing_region r "
    sql$ = sql$ + "WHERE r.building_id = '" + b_id$ + "'::uuid "
    sql$ = sql$ + "AND r.region_kind IN ('FLOORMAP','FACADE','SECTION','CROSS_SECTION') "
    sql$ = sql$ + "ORDER BY r.sort_order ASC, r.created_at ASC"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    n% = POSTGRES_NUM_ROWS(rid%)

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "building_id" + CHR$(34) + ":" + CHR$(34) + b_id$ + CHR$(34) + "," + CHR$(34) + "sections" + CHR$(34) + ":["
    i% = 0
    WHILE i% < n%
        IF i% > 0 THEN
            out$ = out$ + ","
        END IF
        s_id$ = POSTGRES_GET_BY_NAME$(rid%, i%, "id")
        d_id$ = POSTGRES_GET_BY_NAME$(rid%, i%, "document_id")
        page_idx$ = POSTGRES_GET_BY_NAME$(rid%, i%, "page_index")
        label$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "label"), CHR$(34), "")
        kind$ = POSTGRES_GET_BY_NAME$(rid%, i%, "region_kind")
        xmin$ = POSTGRES_GET_BY_NAME$(rid%, i%, "x_min")
        ymin$ = POSTGRES_GET_BY_NAME$(rid%, i%, "y_min")
        xmax$ = POSTGRES_GET_BY_NAME$(rid%, i%, "x_max")
        ymax$ = POSTGRES_GET_BY_NAME$(rid%, i%, "y_max")
        ratio$ = POSTGRES_GET_BY_NAME$(rid%, i%, "scale_ratio")
        mpu$ = POSTGRES_GET_BY_NAME$(rid%, i%, "metres_per_norm_unit")
        aspect$ = POSTGRES_GET_BY_NAME$(rid%, i%, "scale_aspect_yx")
        scale_src$ = POSTGRES_GET_BY_NAME$(rid%, i%, "scale_source")
        rooms$ = POSTGRES_GET_BY_NAME$(rid%, i%, "room_count")
        out$ = out$ + "{" + CHR$(34) + "id" + CHR$(34) + ":" + CHR$(34) + s_id$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "document_id" + CHR$(34) + ":" + CHR$(34) + d_id$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "page_index" + CHR$(34) + ":" + page_idx$
        out$ = out$ + "," + CHR$(34) + "label" + CHR$(34) + ":" + CHR$(34) + label$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "region_kind" + CHR$(34) + ":" + CHR$(34) + kind$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "x_min" + CHR$(34) + ":" + xmin$
        out$ = out$ + "," + CHR$(34) + "y_min" + CHR$(34) + ":" + ymin$
        out$ = out$ + "," + CHR$(34) + "x_max" + CHR$(34) + ":" + xmax$
        out$ = out$ + "," + CHR$(34) + "y_max" + CHR$(34) + ":" + ymax$
        out$ = out$ + "," + CHR$(34) + "scale_ratio" + CHR$(34) + ":"
        IF ratio$ = "" THEN
            out$ = out$ + "null"
        ELSE
            out$ = out$ + ratio$
        END IF
        out$ = out$ + "," + CHR$(34) + "metres_per_norm_unit" + CHR$(34) + ":"
        IF mpu$ = "" THEN
            out$ = out$ + "null"
        ELSE
            out$ = out$ + mpu$
        END IF
        out$ = out$ + "," + CHR$(34) + "scale_aspect_yx" + CHR$(34) + ":"
        IF aspect$ = "" THEN
            out$ = out$ + "null"
        ELSE
            out$ = out$ + aspect$
        END IF
        out$ = out$ + "," + CHR$(34) + "scale_source" + CHR$(34) + ":" + CHR$(34) + scale_src$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "room_count" + CHR$(34) + ":" + rooms$ + "}"
        i% = i% + 1
    WEND
    out$ = out$ + "]}"
    RETURN out$
END PROCEDURE

PROCEDURE API_SaveFloormapScale(session_token$, section_id$, metres_per_norm_unit$, scale_ratio$, scale_source$, scale_aspect_yx$) AS STRING
    DIM sql$, rid%, t$, username$, is_eng$, sec_id$, mpu$, ratio$, src$, aspect$, aspect_sql$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" OR section_id$ = "" OR metres_per_norm_unit$ = "" THEN
        RETURN "ERROR: session_token, section_id, and metres_per_norm_unit are required"
    END IF

    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sec_id$ = SUBSTITUTE$(section_id$, "'", "''")
    mpu$ = SUBSTITUTE$(metres_per_norm_unit$, "'", "''")
    ratio$ = SUBSTITUTE$(scale_ratio$, "'", "''")
    src$ = UCASE$(SUBSTITUTE$(scale_source$, "'", "''"))
    aspect$ = SUBSTITUTE$(scale_aspect_yx$, "'", "''")
    IF src$ <> "PDF_TEXT" AND src$ <> "CALIBRATED" AND src$ <> "NONE" THEN
        src$ = "CALIBRATED"
    END IF

    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    username$ = POSTGRES_GET_BY_NAME$(rid%, 0, "username")
    is_eng$ = POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer")
    IF username$ <> "engineer" AND is_eng$ <> "true" AND is_eng$ <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF

    IF aspect$ = "" OR UCASE$(aspect$) = "NULL" THEN
        aspect_sql$ = "scale_aspect_yx"
    ELSE
        aspect_sql$ = aspect$
    END IF

    sql$ = "UPDATE app_gevelwering.drawing_region SET metres_per_norm_unit = " + mpu$ + ", scale_source = '" + src$ + "', "
    sql$ = sql$ + "scale_aspect_yx = COALESCE(" + aspect_sql$ + ", scale_aspect_yx), updated_at = now()"
    IF ratio$ = "" OR UCASE$(ratio$) = "NULL" THEN
        sql$ = sql$ + ", scale_ratio = NULL"
    ELSE
        sql$ = sql$ + ", scale_ratio = " + ratio$
    END IF
    sql$ = sql$ + " WHERE id = '" + sec_id$ + "'::uuid AND region_kind IN ('FLOORMAP','FACADE','SECTION','CROSS_SECTION') "
    sql$ = sql$ + "RETURNING id::text AS id, COALESCE(scale_aspect_yx, 1)::text AS scale_aspect_yx"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF rid% = -1 THEN
        RETURN "ERROR: scale save failed: " + POSTGRES_GET_ERROR$(g_conn%)
    END IF
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: scalable section not found"
    END IF
    aspect$ = POSTGRES_GET_BY_NAME$(rid%, 0, "scale_aspect_yx")
    IF aspect$ = "" THEN
        aspect$ = "1"
    END IF

    REM area_m2 = area_norm * mpu^2 * aspect; perimeter approx from norm (client recomputes precisely)
    sql$ = "UPDATE app_gevelwering.drawing_subsection SET area_m2 = ROUND((area_norm * (" + mpu$ + ") * (" + mpu$ + ") * (" + aspect$ + "))::numeric, 2), "
    sql$ = sql$ + "perimeter_m = ROUND((perimeter_norm * (" + mpu$ + "))::numeric, 2), "
    sql$ = sql$ + "metres_per_norm_unit = " + mpu$ + ", updated_at = now() "
    sql$ = sql$ + "WHERE section_id = '" + sec_id$ + "'::uuid"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF rid% = -1 THEN
        RETURN "ERROR: subsection recompute failed: " + POSTGRES_GET_ERROR$(g_conn%)
    END IF

    RETURN "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "section_id" + CHR$(34) + ":" + CHR$(34) + sec_id$ + CHR$(34) + "," + CHR$(34) + "metres_per_norm_unit" + CHR$(34) + ":" + mpu$ + "," + CHR$(34) + "scale_aspect_yx" + CHR$(34) + ":" + aspect$ + "," + CHR$(34) + "scale_source" + CHR$(34) + ":" + CHR$(34) + src$ + CHR$(34) + "}"
END PROCEDURE
