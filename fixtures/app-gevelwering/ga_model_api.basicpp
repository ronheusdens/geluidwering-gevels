PROCEDURE API_ListVlakken(session_token$, verblijfsruimte_id$) AS STRING
    DIM sql$, rid%, n%, i%, out$, t$, vr_id$
    DIM id$, omschr$, area$, cl$, cg$, gak$, sort$, fac$, qkind$, len$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF
    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    IF POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "engineer" AND POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "admin" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "true" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF
    IF verblijfsruimte_id$ = "" THEN
        RETURN "ERROR: verblijfsruimte_id is required"
    END IF
    vr_id$ = SUBSTITUTE$(verblijfsruimte_id$, "'", "''")

    sql$ = "SELECT id::text AS id, omschrijving, area_m2::text AS area_m2, "
    sql$ = sql$ + "cl_db::text AS cl_db, cg_db::text AS cg_db, meenemen_gak::text AS meenemen_gak, "
    sql$ = sql$ + "sort_order::text AS sort_order, COALESCE(facade_subsection_id::text,'') AS facade_subsection_id, "
    sql$ = sql$ + "COALESCE(analysis->>'quantity_kind','area') AS quantity_kind, "
    sql$ = sql$ + "COALESCE(analysis->>'length_m','') AS length_m "
    sql$ = sql$ + "FROM app_gevelwering.vlak WHERE verblijfsruimte_id = '" + vr_id$ + "'::uuid "
    sql$ = sql$ + "ORDER BY sort_order ASC, created_at ASC"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    n% = POSTGRES_NUM_ROWS(rid%)

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "verblijfsruimte_id" + CHR$(34) + ":" + CHR$(34) + vr_id$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "vlakken" + CHR$(34) + ":["
    i% = 0
    WHILE i% < n%
        IF i% > 0 THEN
            out$ = out$ + ","
        END IF
        id$ = POSTGRES_GET_BY_NAME$(rid%, i%, "id")
        omschr$ = SUBSTITUTE$(SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "omschrijving"), CHR$(34), ""), CHR$(10), " ")
        area$ = POSTGRES_GET_BY_NAME$(rid%, i%, "area_m2")
        cl$ = POSTGRES_GET_BY_NAME$(rid%, i%, "cl_db")
        cg$ = POSTGRES_GET_BY_NAME$(rid%, i%, "cg_db")
        gak$ = POSTGRES_GET_BY_NAME$(rid%, i%, "meenemen_gak")
        sort$ = POSTGRES_GET_BY_NAME$(rid%, i%, "sort_order")
        fac$ = POSTGRES_GET_BY_NAME$(rid%, i%, "facade_subsection_id")
        qkind$ = POSTGRES_GET_BY_NAME$(rid%, i%, "quantity_kind")
        len$ = POSTGRES_GET_BY_NAME$(rid%, i%, "length_m")
        out$ = out$ + "{" + CHR$(34) + "vlak_id" + CHR$(34) + ":" + CHR$(34) + id$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "omschrijving" + CHR$(34) + ":" + CHR$(34) + omschr$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "area_m2" + CHR$(34) + ":" + area$
        out$ = out$ + "," + CHR$(34) + "cl_db" + CHR$(34) + ":" + cl$
        out$ = out$ + "," + CHR$(34) + "cg_db" + CHR$(34) + ":" + cg$
        out$ = out$ + "," + CHR$(34) + "meenemen_gak" + CHR$(34) + ":"
        IF gak$ = "t" OR gak$ = "true" THEN
            out$ = out$ + "true"
        ELSE
            out$ = out$ + "false"
        END IF
        out$ = out$ + "," + CHR$(34) + "sort_order" + CHR$(34) + ":" + sort$
        out$ = out$ + "," + CHR$(34) + "quantity_kind" + CHR$(34) + ":" + CHR$(34) + qkind$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "length_m" + CHR$(34) + ":"
        IF len$ = "" THEN
            out$ = out$ + "null"
        ELSE
            out$ = out$ + len$
        END IF
        out$ = out$ + "," + CHR$(34) + "facade_subsection_id" + CHR$(34) + ":"
        IF fac$ = "" THEN
            out$ = out$ + "null"
        ELSE
            out$ = out$ + CHR$(34) + fac$ + CHR$(34)
        END IF
        out$ = out$ + "}"
        i% = i% + 1
    WEND
    out$ = out$ + "]}"
    RETURN out$
END PROCEDURE

PROCEDURE API_SaveVlak(session_token$, verblijfsruimte_id$, vlak_id$, omschrijving$, area_m2$, cl_db$, cg_db$, meenemen_gak$, sort_order$, facade_subsection_id$, quantity_kind$, length_m$) AS STRING
    DIM sql$, rid%, t$, vr_id$, vl_id$, omschr$, area$, cl$, cg$, gak$, sort$, fac$, out$, created$, b_id$
    DIM qkind$, len$, anal$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF
    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    IF POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "engineer" AND POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "admin" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "true" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF
    IF verblijfsruimte_id$ = "" OR omschrijving$ = "" THEN
        RETURN "ERROR: verblijfsruimte_id and omschrijving are required"
    END IF

    vr_id$ = SUBSTITUTE$(verblijfsruimte_id$, "'", "''")
    vl_id$ = SUBSTITUTE$(vlak_id$, "'", "''")
    omschr$ = SUBSTITUTE$(omschrijving$, "'", "''")
    area$ = SUBSTITUTE$(area_m2$, "'", "''")
    cl$ = SUBSTITUTE$(cl_db$, "'", "''")
    cg$ = SUBSTITUTE$(cg_db$, "'", "''")
    gak$ = meenemen_gak$
    sort$ = SUBSTITUTE$(sort_order$, "'", "''")
    fac$ = SUBSTITUTE$(facade_subsection_id$, "'", "''")
    qkind$ = LCASE$(SUBSTITUTE$(quantity_kind$, "'", "''"))
    len$ = SUBSTITUTE$(length_m$, "'", "''")
    IF qkind$ <> "length" THEN
        qkind$ = "area"
    END IF
    IF qkind$ = "length" THEN
        area$ = "0"
        IF len$ = "" THEN
            len$ = "0"
        END IF
        anal$ = "{" + CHR$(34) + "quantity_kind" + CHR$(34) + ":" + CHR$(34) + "length" + CHR$(34)
        anal$ = anal$ + "," + CHR$(34) + "length_m" + CHR$(34) + ":" + len$ + "}"
    ELSE
        IF area$ = "" THEN
            area$ = "0"
        END IF
        anal$ = "{" + CHR$(34) + "quantity_kind" + CHR$(34) + ":" + CHR$(34) + "area" + CHR$(34) + "}"
    END IF
    IF cl$ = "" THEN
        cl$ = "0"
    END IF
    IF cg$ = "" THEN
        cg$ = "0"
    END IF
    IF sort$ = "" THEN
        sort$ = "0"
    END IF
    IF gak$ = "" OR gak$ = "1" OR gak$ = "true" OR gak$ = "t" OR gak$ = "True" OR gak$ = "yes" THEN
        gak$ = "true"
    ELSE
        gak$ = "false"
    END IF

    sql$ = "SELECT building_id::text AS building_id FROM app_gevelwering.verblijfsruimte WHERE id = '" + vr_id$ + "'::uuid"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: verblijfsruimte not found"
    END IF
    b_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "building_id")

    IF vlak_id$ = "" THEN
        sql$ = "INSERT INTO app_gevelwering.vlak (verblijfsruimte_id, building_id, omschrijving, area_m2, cl_db, cg_db, meenemen_gak, sort_order, facade_subsection_id, analysis) "
        sql$ = sql$ + "VALUES ('" + vr_id$ + "'::uuid, '" + b_id$ + "'::uuid, '" + omschr$ + "', "
        sql$ = sql$ + area$ + "::double precision, " + cl$ + "::double precision, " + cg$ + "::double precision, "
        sql$ = sql$ + gak$ + "::boolean, " + sort$ + "::integer, "
        IF fac$ = "" THEN
            sql$ = sql$ + "NULL"
        ELSE
            sql$ = sql$ + "'" + fac$ + "'::uuid"
        END IF
        sql$ = sql$ + ", '" + SUBSTITUTE$(anal$, "'", "''") + "'::jsonb"
        sql$ = sql$ + ") RETURNING id::text AS id"
        created$ = "true"
    ELSE
        sql$ = "UPDATE app_gevelwering.vlak SET omschrijving = '" + omschr$ + "', area_m2 = " + area$ + "::double precision, "
        sql$ = sql$ + "cl_db = " + cl$ + "::double precision, cg_db = " + cg$ + "::double precision, "
        sql$ = sql$ + "meenemen_gak = " + gak$ + "::boolean, sort_order = " + sort$ + "::integer, "
        sql$ = sql$ + "analysis = '" + SUBSTITUTE$(anal$, "'", "''") + "'::jsonb, "
        sql$ = sql$ + "facade_subsection_id = "
        IF fac$ = "" THEN
            sql$ = sql$ + "NULL"
        ELSE
            sql$ = sql$ + "'" + fac$ + "'::uuid"
        END IF
        sql$ = sql$ + ", updated_at = now() WHERE id = '" + vl_id$ + "'::uuid AND verblijfsruimte_id = '" + vr_id$ + "'::uuid "
        sql$ = sql$ + "RETURNING id::text AS id"
        created$ = "false"
    END IF
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: vlak save failed"
    END IF
    vl_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "id")
    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "vlak_id" + CHR$(34) + ":" + CHR$(34) + vl_id$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "created" + CHR$(34) + ":" + created$ + "}"
    RETURN out$
END PROCEDURE

PROCEDURE API_DeleteVlak(session_token$, vlak_id$) AS STRING
    DIM sql$, rid%, t$, vl_id$, out$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
