REM =============================================================================
REM Acoustics P0 — GA model CRUD (DDL 0.2.16)
REM variant → verblijfsgebied → verblijfsruimte → vlak → vlak_element
REM Engineer APIs. VG+VR: create together; cannot delete last VR (delete VG).
REM VR always linked to floormap drawing_subsection.
REM =============================================================================

PROCEDURE API_GaPing() AS STRING
    RETURN "pong"
END PROCEDURE



REM ---------------------------------------------------------------------------
REM Variant
REM ---------------------------------------------------------------------------

PROCEDURE API_ListVariants(session_token$, building_id$) AS STRING
    DIM sql$, rid%, n%, i%, out$, t$, b_id$
    DIM id$, omschr$, functie$, lb$, kind$, sort$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    REM --- auth (inlined) ---
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF
    b_id$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + b_id$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    omschr$ = POSTGRES_GET_BY_NAME$(rid%, 0, "username")
    functie$ = POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer")
    IF omschr$ <> "engineer" AND omschr$ <> "admin" AND functie$ <> "true" AND functie$ <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF
    IF building_id$ = "" THEN
        RETURN "ERROR: building_id is required"
    END IF
    b_id$ = SUBSTITUTE$(building_id$, "'", "''")

    sql$ = "SELECT id::text AS id, omschrijving, gebruiksfunctie, "
    sql$ = sql$ + "geluidsbelasting_dba::text AS geluidsbelasting_dba, spectrum_kind, "
    sql$ = sql$ + "sort_order::text AS sort_order "
    sql$ = sql$ + "FROM app_gevelwering.variant WHERE building_id = '" + b_id$ + "'::uuid "
    sql$ = sql$ + "ORDER BY sort_order ASC, created_at ASC"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    n% = POSTGRES_NUM_ROWS(rid%)

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "building_id" + CHR$(34) + ":" + CHR$(34) + b_id$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "variants" + CHR$(34) + ":["
    i% = 0
    WHILE i% < n%
        IF i% > 0 THEN
            out$ = out$ + ","
        END IF
        id$ = POSTGRES_GET_BY_NAME$(rid%, i%, "id")
        omschr$ = SUBSTITUTE$(SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "omschrijving"), CHR$(34), ""), CHR$(10), " ")
        functie$ = SUBSTITUTE$(SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "gebruiksfunctie"), CHR$(34), ""), CHR$(10), " ")
        lb$ = POSTGRES_GET_BY_NAME$(rid%, i%, "geluidsbelasting_dba")
        kind$ = POSTGRES_GET_BY_NAME$(rid%, i%, "spectrum_kind")
        sort$ = POSTGRES_GET_BY_NAME$(rid%, i%, "sort_order")
        out$ = out$ + "{" + CHR$(34) + "variant_id" + CHR$(34) + ":" + CHR$(34) + id$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "omschrijving" + CHR$(34) + ":" + CHR$(34) + omschr$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "gebruiksfunctie" + CHR$(34) + ":" + CHR$(34) + functie$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "geluidsbelasting_dba" + CHR$(34) + ":" + lb$
        out$ = out$ + "," + CHR$(34) + "spectrum_kind" + CHR$(34) + ":" + CHR$(34) + kind$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "sort_order" + CHR$(34) + ":" + sort$ + "}"
        i% = i% + 1
    WEND
    out$ = out$ + "]}"
    RETURN out$
END PROCEDURE

PROCEDURE API_SaveVariant(session_token$, building_id$, variant_id$, omschrijving$, gebruiksfunctie$, geluidsbelasting$, spectrum_kind$, sort_order$) AS STRING
    DIM sql$, rid%, t$, b_id$, v_id$, omschr$, functie$, lb$, kind$, sort$, out$, created$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF
    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    IF POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "engineer" AND POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "admin" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "true" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF
    IF building_id$ = "" OR omschrijving$ = "" THEN
        RETURN "ERROR: building_id and omschrijving are required"
    END IF

    b_id$ = SUBSTITUTE$(building_id$, "'", "''")
    v_id$ = SUBSTITUTE$(variant_id$, "'", "''")
    omschr$ = SUBSTITUTE$(omschrijving$, "'", "''")
    functie$ = SUBSTITUTE$(gebruiksfunctie$, "'", "''")
    IF functie$ = "" THEN
        functie$ = "Woonfunctie"
    END IF
    lb$ = SUBSTITUTE$(geluidsbelasting$, "'", "''")
    IF lb$ = "" THEN
        lb$ = "0"
    END IF
    kind$ = SUBSTITUTE$(spectrum_kind$, "'", "''")
    IF kind$ = "" THEN
        kind$ = "SPECTRUM_2"
    END IF
    sort$ = SUBSTITUTE$(sort_order$, "'", "''")
    IF sort$ = "" THEN
        sort$ = "0"
    END IF

    IF variant_id$ = "" THEN
        sql$ = "INSERT INTO app_gevelwering.variant (building_id, omschrijving, gebruiksfunctie, geluidsbelasting_dba, spectrum_kind, sort_order) "
        sql$ = sql$ + "VALUES ('" + b_id$ + "'::uuid, '" + omschr$ + "', '" + functie$ + "', " + lb$ + "::double precision, "
        sql$ = sql$ + "'" + kind$ + "', " + sort$ + "::integer) RETURNING id::text AS id"
        created$ = "true"
    ELSE
        sql$ = "UPDATE app_gevelwering.variant SET omschrijving = '" + omschr$ + "', gebruiksfunctie = '" + functie$ + "', "
        sql$ = sql$ + "geluidsbelasting_dba = " + lb$ + "::double precision, spectrum_kind = '" + kind$ + "', "
        sql$ = sql$ + "sort_order = " + sort$ + "::integer, updated_at = now() "
        sql$ = sql$ + "WHERE id = '" + v_id$ + "'::uuid AND building_id = '" + b_id$ + "'::uuid "
        sql$ = sql$ + "RETURNING id::text AS id"
        created$ = "false"
    END IF
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: variant save failed (check gebruiksfunctie/spectrum_kind/building_id)"
    END IF
    v_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "id")
    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "variant_id" + CHR$(34) + ":" + CHR$(34) + v_id$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "created" + CHR$(34) + ":" + created$ + "}"
    RETURN out$
END PROCEDURE

PROCEDURE API_DeleteVariant(session_token$, variant_id$) AS STRING
    DIM sql$, rid%, t$, v_id$, out$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF
    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    IF POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "engineer" AND POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "admin" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "true" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF
    IF variant_id$ = "" THEN
        RETURN "ERROR: variant_id is required"
    END IF
    v_id$ = SUBSTITUTE$(variant_id$, "'", "''")
    sql$ = "DELETE FROM app_gevelwering.variant WHERE id = '" + v_id$ + "'::uuid RETURNING id::text AS id"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: variant not found"
    END IF
    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "variant_id" + CHR$(34) + ":" + CHR$(34) + v_id$ + CHR$(34) + "}"
    RETURN out$
END PROCEDURE

REM ---------------------------------------------------------------------------
REM Verblijfsgebied + Verblijfsruimte (samen)
REM ---------------------------------------------------------------------------

PROCEDURE API_ListVerblijfsgebieden(session_token$, variant_id$) AS STRING
    DIM sql$, rid%, n%, i%, out$, t$, v_id$
    DIM id$, omschr$, sort$, nvr$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF
    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    IF POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "engineer" AND POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "admin" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "true" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF
    IF variant_id$ = "" THEN
        RETURN "ERROR: variant_id is required"
    END IF
    v_id$ = SUBSTITUTE$(variant_id$, "'", "''")

    sql$ = "SELECT g.id::text AS id, g.omschrijving, g.sort_order::text AS sort_order, "
    sql$ = sql$ + "(SELECT COUNT(*)::text FROM app_gevelwering.verblijfsruimte r WHERE r.verblijfsgebied_id = g.id) AS vr_count "
    sql$ = sql$ + "FROM app_gevelwering.verblijfsgebied g WHERE g.variant_id = '" + v_id$ + "'::uuid "
    sql$ = sql$ + "ORDER BY g.sort_order ASC, g.created_at ASC"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    n% = POSTGRES_NUM_ROWS(rid%)

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "variant_id" + CHR$(34) + ":" + CHR$(34) + v_id$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "verblijfsgebieden" + CHR$(34) + ":["
    i% = 0
    WHILE i% < n%
        IF i% > 0 THEN
            out$ = out$ + ","
        END IF
        id$ = POSTGRES_GET_BY_NAME$(rid%, i%, "id")
        omschr$ = SUBSTITUTE$(SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "omschrijving"), CHR$(34), ""), CHR$(10), " ")
        sort$ = POSTGRES_GET_BY_NAME$(rid%, i%, "sort_order")
        nvr$ = POSTGRES_GET_BY_NAME$(rid%, i%, "vr_count")
        out$ = out$ + "{" + CHR$(34) + "verblijfsgebied_id" + CHR$(34) + ":" + CHR$(34) + id$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "omschrijving" + CHR$(34) + ":" + CHR$(34) + omschr$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "sort_order" + CHR$(34) + ":" + sort$
        out$ = out$ + "," + CHR$(34) + "vr_count" + CHR$(34) + ":" + nvr$ + "}"
        i% = i% + 1
    WEND
    out$ = out$ + "]}"
    RETURN out$
END PROCEDURE

PROCEDURE API_CreateVerblijfsgebied(session_token$, variant_id$, omschrijving$, subsection_id$, vr_omschrijving$, vloer_m2$, hoogte_m$, t0_s$) AS STRING
    DIM sql$, rid%, t$, v_id$, omschr$, sub_id$, vr_omschr$, vloer$, hoogte$, t0$, vol$, out$
    DIM vg_id$, vr_id$, b_id$, area$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF
    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    IF POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "engineer" AND POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "admin" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "true" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF
    IF variant_id$ = "" OR omschrijving$ = "" OR subsection_id$ = "" THEN
        RETURN "ERROR: variant_id, omschrijving and subsection_id are required"
    END IF

    v_id$ = SUBSTITUTE$(variant_id$, "'", "''")
    omschr$ = SUBSTITUTE$(omschrijving$, "'", "''")
    sub_id$ = SUBSTITUTE$(subsection_id$, "'", "''")
    vr_omschr$ = SUBSTITUTE$(vr_omschrijving$, "'", "''")
    IF vr_omschr$ = "" THEN
        vr_omschr$ = omschr$
    END IF
    vloer$ = SUBSTITUTE$(vloer_m2$, "'", "''")
    hoogte$ = SUBSTITUTE$(hoogte_m$, "'", "''")
    t0$ = SUBSTITUTE$(t0_s$, "'", "''")
    IF hoogte$ = "" THEN
        hoogte$ = "0"
    END IF
    IF t0$ = "" THEN
        t0$ = "0.5"
    END IF

    REM Verify variant + subsection same building; subsection unused
    sql$ = "SELECT v.building_id::text AS building_id, "
    sql$ = sql$ + "COALESCE(s.area_m2::text,'') AS area_m2, "
    sql$ = sql$ + "CASE WHEN s.id IS NULL THEN 'missing' "
    sql$ = sql$ + "WHEN s.building_id IS DISTINCT FROM v.building_id THEN 'building_mismatch' "
    sql$ = sql$ + "WHEN EXISTS (SELECT 1 FROM app_gevelwering.verblijfsruimte r WHERE r.subsection_id = s.id) THEN 'subsection_in_use' "
    sql$ = sql$ + "ELSE 'ok' END AS status "
    sql$ = sql$ + "FROM app_gevelwering.variant v "
    sql$ = sql$ + "LEFT JOIN app_gevelwering.drawing_subsection s ON s.id = '" + sub_id$ + "'::uuid "
    sql$ = sql$ + "WHERE v.id = '" + v_id$ + "'::uuid"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: variant not found"
    END IF
    IF POSTGRES_GET_BY_NAME$(rid%, 0, "status") = "missing" THEN
        RETURN "ERROR: subsection not found"
    END IF
    IF POSTGRES_GET_BY_NAME$(rid%, 0, "status") = "building_mismatch" THEN
        RETURN "ERROR: subsection belongs to another building"
    END IF
    IF POSTGRES_GET_BY_NAME$(rid%, 0, "status") = "subsection_in_use" THEN
        RETURN "ERROR: subsection already linked to a verblijfsruimte"
    END IF
    b_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "building_id")
    area$ = POSTGRES_GET_BY_NAME$(rid%, 0, "area_m2")
    IF vloer$ = "" THEN
        IF area$ = "" THEN
            vloer$ = "0"
        ELSE
            vloer$ = area$
        END IF
    END IF
    vol$ = "0"
    IF VAL(vloer$) > 0 AND VAL(hoogte$) > 0 THEN
        vol$ = STR$(VAL(vloer$) * VAL(hoogte$))
    END IF

    sql$ = "WITH vg AS ("
    sql$ = sql$ + "INSERT INTO app_gevelwering.verblijfsgebied (variant_id, building_id, omschrijving) "
    sql$ = sql$ + "VALUES ('" + v_id$ + "'::uuid, '" + b_id$ + "'::uuid, '" + omschr$ + "') "
    sql$ = sql$ + "RETURNING id, building_id"
    sql$ = sql$ + "), vr AS ("
    sql$ = sql$ + "INSERT INTO app_gevelwering.verblijfsruimte "
    sql$ = sql$ + "(verblijfsgebied_id, building_id, subsection_id, omschrijving, vloer_m2, hoogte_m, volume_m3, t0_s) "
    sql$ = sql$ + "SELECT vg.id, vg.building_id, '" + sub_id$ + "'::uuid, '" + vr_omschr$ + "', "
    sql$ = sql$ + vloer$ + "::double precision, " + hoogte$ + "::double precision, "
    sql$ = sql$ + vol$ + "::double precision, " + t0$ + "::double precision FROM vg "
    sql$ = sql$ + "RETURNING id, verblijfsgebied_id"
    sql$ = sql$ + ") SELECT vg.id::text AS verblijfsgebied_id, vr.id::text AS verblijfsruimte_id FROM vg, vr"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: create verblijfsgebied failed"
    END IF
    vg_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "verblijfsgebied_id")
    vr_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "verblijfsruimte_id")
    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true"
    out$ = out$ + "," + CHR$(34) + "verblijfsgebied_id" + CHR$(34) + ":" + CHR$(34) + vg_id$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "verblijfsruimte_id" + CHR$(34) + ":" + CHR$(34) + vr_id$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "subsection_id" + CHR$(34) + ":" + CHR$(34) + sub_id$ + CHR$(34) + "}"
    RETURN out$
END PROCEDURE

PROCEDURE API_SaveVerblijfsgebied(session_token$, verblijfsgebied_id$, omschrijving$, sort_order$) AS STRING
    DIM sql$, rid%, t$, vg_id$, omschr$, sort$, out$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF
    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    IF POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "engineer" AND POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "admin" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "true" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF
    IF verblijfsgebied_id$ = "" OR omschrijving$ = "" THEN
        RETURN "ERROR: verblijfsgebied_id and omschrijving are required"
    END IF
    vg_id$ = SUBSTITUTE$(verblijfsgebied_id$, "'", "''")
    omschr$ = SUBSTITUTE$(omschrijving$, "'", "''")
    sort$ = SUBSTITUTE$(sort_order$, "'", "''")
    IF sort$ = "" THEN
        sort$ = "0"
    END IF
    sql$ = "UPDATE app_gevelwering.verblijfsgebied SET omschrijving = '" + omschr$ + "', "
    sql$ = sql$ + "sort_order = " + sort$ + "::integer, updated_at = now() "
    sql$ = sql$ + "WHERE id = '" + vg_id$ + "'::uuid RETURNING id::text AS id"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: verblijfsgebied not found"
    END IF
    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "verblijfsgebied_id" + CHR$(34) + ":" + CHR$(34) + vg_id$ + CHR$(34) + "}"
    RETURN out$
END PROCEDURE

PROCEDURE API_DeleteVerblijfsgebied(session_token$, verblijfsgebied_id$) AS STRING
    DIM sql$, rid%, t$, vg_id$, out$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
