    IF POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "engineer" AND POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "admin" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "true" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF
    IF verblijfsgebied_id$ = "" THEN
        RETURN "ERROR: verblijfsgebied_id is required"
    END IF
    vg_id$ = SUBSTITUTE$(verblijfsgebied_id$, "'", "''")
    sql$ = "DELETE FROM app_gevelwering.verblijfsgebied WHERE id = '" + vg_id$ + "'::uuid RETURNING id::text AS id"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: verblijfsgebied not found"
    END IF
    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "verblijfsgebied_id" + CHR$(34) + ":" + CHR$(34) + vg_id$ + CHR$(34) + "}"
    RETURN out$
END PROCEDURE

PROCEDURE API_ListVerblijfsruimten(session_token$, verblijfsgebied_id$) AS STRING
    DIM sql$, rid%, n%, i%, out$, t$, vg_id$
    DIM id$, omschr$, sub$, vloer$, hoogte$, vol$, t0$, sort$, ga$, lbi$, gak$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF
    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    IF POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "engineer" AND POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "admin" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "true" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF
    IF verblijfsgebied_id$ = "" THEN
        RETURN "ERROR: verblijfsgebied_id is required"
    END IF
    vg_id$ = SUBSTITUTE$(verblijfsgebied_id$, "'", "''")

    sql$ = "SELECT r.id::text AS id, r.omschrijving, r.subsection_id::text AS subsection_id, "
    sql$ = sql$ + "COALESCE(s.area_m2, r.vloer_m2)::text AS vloer_m2, "
    sql$ = sql$ + "r.hoogte_m::text AS hoogte_m, "
    sql$ = sql$ + "CASE WHEN s.area_m2 IS NOT NULL AND r.hoogte_m > 0 "
    sql$ = sql$ + "THEN ROUND((s.area_m2 * r.hoogte_m)::numeric, 2)::text "
    sql$ = sql$ + "ELSE r.volume_m3::text END AS volume_m3, "
    sql$ = sql$ + "r.t0_s::text AS t0_s, r.sort_order::text AS sort_order, "
    sql$ = sql$ + "COALESCE(r.ga_dba::text,'') AS ga_dba, COALESCE(r.lbi_dba::text,'') AS lbi_dba, "
    sql$ = sql$ + "COALESCE(r.gak_dba::text,'') AS gak_dba "
    sql$ = sql$ + "FROM app_gevelwering.verblijfsruimte r "
    sql$ = sql$ + "LEFT JOIN app_gevelwering.drawing_subsection s ON s.id = r.subsection_id "
    sql$ = sql$ + "WHERE r.verblijfsgebied_id = '" + vg_id$ + "'::uuid "
    sql$ = sql$ + "ORDER BY r.sort_order ASC, r.created_at ASC"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    n% = POSTGRES_NUM_ROWS(rid%)

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "verblijfsgebied_id" + CHR$(34) + ":" + CHR$(34) + vg_id$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "verblijfsruimten" + CHR$(34) + ":["
    i% = 0
    WHILE i% < n%
        IF i% > 0 THEN
            out$ = out$ + ","
        END IF
        id$ = POSTGRES_GET_BY_NAME$(rid%, i%, "id")
        omschr$ = SUBSTITUTE$(SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "omschrijving"), CHR$(34), ""), CHR$(10), " ")
        sub$ = POSTGRES_GET_BY_NAME$(rid%, i%, "subsection_id")
        vloer$ = POSTGRES_GET_BY_NAME$(rid%, i%, "vloer_m2")
        hoogte$ = POSTGRES_GET_BY_NAME$(rid%, i%, "hoogte_m")
        vol$ = POSTGRES_GET_BY_NAME$(rid%, i%, "volume_m3")
        t0$ = POSTGRES_GET_BY_NAME$(rid%, i%, "t0_s")
        sort$ = POSTGRES_GET_BY_NAME$(rid%, i%, "sort_order")
        ga$ = POSTGRES_GET_BY_NAME$(rid%, i%, "ga_dba")
        lbi$ = POSTGRES_GET_BY_NAME$(rid%, i%, "lbi_dba")
        gak$ = POSTGRES_GET_BY_NAME$(rid%, i%, "gak_dba")
        out$ = out$ + "{" + CHR$(34) + "verblijfsruimte_id" + CHR$(34) + ":" + CHR$(34) + id$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "omschrijving" + CHR$(34) + ":" + CHR$(34) + omschr$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "subsection_id" + CHR$(34) + ":" + CHR$(34) + sub$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "vloer_m2" + CHR$(34) + ":" + vloer$
        out$ = out$ + "," + CHR$(34) + "hoogte_m" + CHR$(34) + ":" + hoogte$
        out$ = out$ + "," + CHR$(34) + "volume_m3" + CHR$(34) + ":" + vol$
        out$ = out$ + "," + CHR$(34) + "t0_s" + CHR$(34) + ":" + t0$
        out$ = out$ + "," + CHR$(34) + "sort_order" + CHR$(34) + ":" + sort$
        out$ = out$ + "," + CHR$(34) + "ga_dba" + CHR$(34) + ":"
        IF ga$ = "" THEN
            out$ = out$ + "null"
        ELSE
            out$ = out$ + ga$
        END IF
        out$ = out$ + "," + CHR$(34) + "lbi_dba" + CHR$(34) + ":"
        IF lbi$ = "" THEN
            out$ = out$ + "null"
        ELSE
            out$ = out$ + lbi$
        END IF
        out$ = out$ + "," + CHR$(34) + "gak_dba" + CHR$(34) + ":"
        IF gak$ = "" THEN
            out$ = out$ + "null"
        ELSE
            out$ = out$ + gak$
        END IF
        out$ = out$ + "}"
        i% = i% + 1
    WEND
    out$ = out$ + "]}"
    RETURN out$
END PROCEDURE

PROCEDURE API_AddVerblijfsruimte(session_token$, verblijfsgebied_id$, subsection_id$, omschrijving$, vloer_m2$, hoogte_m$, t0_s$) AS STRING
    DIM sql$, rid%, t$, vg_id$, sub_id$, omschr$, vloer$, hoogte$, t0$, vol$, out$, vr_id$, b_id$, area$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF
    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    IF POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "engineer" AND POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "admin" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "true" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF
    IF verblijfsgebied_id$ = "" OR subsection_id$ = "" OR omschrijving$ = "" THEN
        RETURN "ERROR: verblijfsgebied_id, subsection_id and omschrijving are required"
    END IF

    vg_id$ = SUBSTITUTE$(verblijfsgebied_id$, "'", "''")
    sub_id$ = SUBSTITUTE$(subsection_id$, "'", "''")
    omschr$ = SUBSTITUTE$(omschrijving$, "'", "''")
    vloer$ = SUBSTITUTE$(vloer_m2$, "'", "''")
    hoogte$ = SUBSTITUTE$(hoogte_m$, "'", "''")
    t0$ = SUBSTITUTE$(t0_s$, "'", "''")
    IF hoogte$ = "" THEN
        hoogte$ = "0"
    END IF
    IF t0$ = "" THEN
        t0$ = "0.5"
    END IF

    sql$ = "SELECT g.building_id::text AS building_id, "
    sql$ = sql$ + "COALESCE(s.area_m2::text,'') AS area_m2, "
    sql$ = sql$ + "CASE WHEN s.id IS NULL THEN 'missing' "
    sql$ = sql$ + "WHEN s.building_id IS DISTINCT FROM g.building_id THEN 'building_mismatch' "
    sql$ = sql$ + "WHEN EXISTS (SELECT 1 FROM app_gevelwering.verblijfsruimte r WHERE r.subsection_id = s.id) THEN 'subsection_in_use' "
    sql$ = sql$ + "ELSE 'ok' END AS status "
    sql$ = sql$ + "FROM app_gevelwering.verblijfsgebied g "
    sql$ = sql$ + "LEFT JOIN app_gevelwering.drawing_subsection s ON s.id = '" + sub_id$ + "'::uuid "
    sql$ = sql$ + "WHERE g.id = '" + vg_id$ + "'::uuid"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: verblijfsgebied not found"
    END IF
    IF POSTGRES_GET_BY_NAME$(rid%, 0, "status") <> "ok" THEN
        RETURN "ERROR: " + POSTGRES_GET_BY_NAME$(rid%, 0, "status")
    END IF
    b_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "building_id")
    area$ = POSTGRES_GET_BY_NAME$(rid%, 0, "area_m2")
    IF vloer$ = "" THEN
        IF area$ = "" THEN
            vloer$ = "0"
        ELSE
            vloer$ = area$
        END IF
    END IF
    vol$ = "0"
    IF VAL(vloer$) > 0 AND VAL(hoogte$) > 0 THEN
        vol$ = STR$(VAL(vloer$) * VAL(hoogte$))
    END IF

    sql$ = "INSERT INTO app_gevelwering.verblijfsruimte "
    sql$ = sql$ + "(verblijfsgebied_id, building_id, subsection_id, omschrijving, vloer_m2, hoogte_m, volume_m3, t0_s) "
    sql$ = sql$ + "VALUES ('" + vg_id$ + "'::uuid, '" + b_id$ + "'::uuid, '" + sub_id$ + "'::uuid, '" + omschr$ + "', "
    sql$ = sql$ + vloer$ + "::double precision, " + hoogte$ + "::double precision, "
    sql$ = sql$ + vol$ + "::double precision, " + t0$ + "::double precision) "
    sql$ = sql$ + "RETURNING id::text AS id"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: add verblijfsruimte failed"
    END IF
    vr_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "id")
    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "verblijfsruimte_id" + CHR$(34) + ":" + CHR$(34) + vr_id$ + CHR$(34) + "}"
    RETURN out$
END PROCEDURE

PROCEDURE API_SaveVerblijfsruimte(session_token$, verblijfsruimte_id$, omschrijving$, vloer_m2$, hoogte_m$, volume_m3$, t0_s$, sort_order$) AS STRING
    DIM sql$, rid%, t$, vr_id$, omschr$, vloer$, hoogte$, vol$, t0$, sort$, out$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF
    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    IF POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "engineer" AND POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "admin" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "true" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF
    IF verblijfsruimte_id$ = "" OR omschrijving$ = "" THEN
        RETURN "ERROR: verblijfsruimte_id and omschrijving are required"
    END IF
    vr_id$ = SUBSTITUTE$(verblijfsruimte_id$, "'", "''")
    omschr$ = SUBSTITUTE$(omschrijving$, "'", "''")
    vloer$ = SUBSTITUTE$(vloer_m2$, "'", "''")
    hoogte$ = SUBSTITUTE$(hoogte_m$, "'", "''")
    vol$ = SUBSTITUTE$(volume_m3$, "'", "''")
    t0$ = SUBSTITUTE$(t0_s$, "'", "''")
    sort$ = SUBSTITUTE$(sort_order$, "'", "''")
    IF vloer$ = "" THEN
        vloer$ = "0"
    END IF
    IF hoogte$ = "" THEN
        hoogte$ = "0"
    END IF
    IF t0$ = "" THEN
        t0$ = "0.5"
    END IF
    IF sort$ = "" THEN
        sort$ = "0"
    END IF
    IF vol$ = "" THEN
        IF VAL(vloer$) > 0 AND VAL(hoogte$) > 0 THEN
            vol$ = STR$(VAL(vloer$) * VAL(hoogte$))
        ELSE
            vol$ = "0"
        END IF
    END IF

    sql$ = "UPDATE app_gevelwering.verblijfsruimte SET omschrijving = '" + omschr$ + "', "
    sql$ = sql$ + "vloer_m2 = " + vloer$ + "::double precision, hoogte_m = " + hoogte$ + "::double precision, "
    sql$ = sql$ + "volume_m3 = " + vol$ + "::double precision, t0_s = " + t0$ + "::double precision, "
    sql$ = sql$ + "sort_order = " + sort$ + "::integer, updated_at = now() "
    sql$ = sql$ + "WHERE id = '" + vr_id$ + "'::uuid RETURNING id::text AS id"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: verblijfsruimte not found"
    END IF
    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "verblijfsruimte_id" + CHR$(34) + ":" + CHR$(34) + vr_id$ + CHR$(34) + "}"
    RETURN out$
END PROCEDURE

PROCEDURE API_DeleteVerblijfsruimte(session_token$, verblijfsruimte_id$) AS STRING
    DIM sql$, rid%, t$, vr_id$, out$, n$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF
    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    IF POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "engineer" AND POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "admin" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "true" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF
    IF verblijfsruimte_id$ = "" THEN
        RETURN "ERROR: verblijfsruimte_id is required"
    END IF
    vr_id$ = SUBSTITUTE$(verblijfsruimte_id$, "'", "''")

    sql$ = "SELECT COUNT(*)::text AS n FROM app_gevelwering.verblijfsruimte "
    sql$ = sql$ + "WHERE verblijfsgebied_id = (SELECT verblijfsgebied_id FROM app_gevelwering.verblijfsruimte WHERE id = '" + vr_id$ + "'::uuid)"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: verblijfsruimte not found"
    END IF
    n$ = POSTGRES_GET_BY_NAME$(rid%, 0, "n")
    IF VAL(n$) <= 1 THEN
        RETURN "ERROR: cannot delete last verblijfsruimte — delete verblijfsgebied instead"
    END IF

    sql$ = "DELETE FROM app_gevelwering.verblijfsruimte WHERE id = '" + vr_id$ + "'::uuid RETURNING id::text AS id"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: verblijfsruimte not found"
    END IF
    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "verblijfsruimte_id" + CHR$(34) + ":" + CHR$(34) + vr_id$ + CHR$(34) + "}"
    RETURN out$
END PROCEDURE

PROCEDURE API_SaveVerblijfsruimteResults(session_token$, verblijfsruimte_id$, ga_dba$, lbi_dba$, gak_dba$) AS STRING
    DIM sql$, rid%, t$, vr_id$, ga$, lbi$, gak$, out$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF
    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
