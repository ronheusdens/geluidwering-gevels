    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    IF POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "engineer" AND POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "admin" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "true" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF
    IF verblijfsruimte_id$ = "" THEN
        RETURN "ERROR: verblijfsruimte_id is required"
    END IF
    vr_id$ = SUBSTITUTE$(verblijfsruimte_id$, "'", "''")
    ga$ = SUBSTITUTE$(ga_dba$, "'", "''")
    lbi$ = SUBSTITUTE$(lbi_dba$, "'", "''")
    gak$ = SUBSTITUTE$(gak_dba$, "'", "''")

    sql$ = "UPDATE app_gevelwering.verblijfsruimte SET "
    sql$ = sql$ + "ga_dba = "
    IF ga$ = "" THEN
        sql$ = sql$ + "NULL"
    ELSE
        sql$ = sql$ + ga$ + "::double precision"
    END IF
    sql$ = sql$ + ", lbi_dba = "
    IF lbi$ = "" THEN
        sql$ = sql$ + "NULL"
    ELSE
        sql$ = sql$ + lbi$ + "::double precision"
    END IF
    sql$ = sql$ + ", gak_dba = "
    IF gak$ = "" THEN
        sql$ = sql$ + "NULL"
    ELSE
        sql$ = sql$ + gak$ + "::double precision"
    END IF
    sql$ = sql$ + ", updated_at = now() WHERE id = '" + vr_id$ + "'::uuid "
    sql$ = sql$ + "RETURNING id::text AS id"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: verblijfsruimte not found"
    END IF
    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "verblijfsruimte_id" + CHR$(34) + ":" + CHR$(34) + vr_id$ + CHR$(34) + "}"
    RETURN out$
END PROCEDURE

