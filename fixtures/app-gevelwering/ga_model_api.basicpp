        RETURN "ERROR: vlak not found"
    END IF
    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "vlak_id" + CHR$(34) + ":" + CHR$(34) + vl_id$ + CHR$(34) + "}"
    RETURN out$
END PROCEDURE

REM ---------------------------------------------------------------------------
REM Vlak-element
REM ---------------------------------------------------------------------------

PROCEDURE API_ListVlakElementen(session_token$, vlak_id$) AS STRING
    DIM sql$, rid%, n%, i%, out$, t$, vl_id$
    DIM id$, mat$, omschr$, area$, len$, qv$, sort$, cat$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF
    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    IF POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "engineer" AND POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "admin" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "true" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF
    IF vlak_id$ = "" THEN
        RETURN "ERROR: vlak_id is required"
    END IF
    vl_id$ = SUBSTITUTE$(vlak_id$, "'", "''")

    sql$ = "SELECT e.id::text AS id, COALESCE(e.material_id::text,'') AS material_id, e.omschrijving, "
    sql$ = sql$ + "e.area_m2::text AS area_m2, e.length_m::text AS length_m, e.qvent::text AS qvent, "
    sql$ = sql$ + "e.sort_order::text AS sort_order, COALESCE(m.catalog_id,'') AS catalog_id "
    sql$ = sql$ + "FROM app_gevelwering.vlak_element e "
    sql$ = sql$ + "LEFT JOIN app_gevelwering.material m ON m.id = e.material_id "
    sql$ = sql$ + "WHERE e.vlak_id = '" + vl_id$ + "'::uuid "
    sql$ = sql$ + "ORDER BY e.sort_order ASC, e.created_at ASC"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    n% = POSTGRES_NUM_ROWS(rid%)

    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "vlak_id" + CHR$(34) + ":" + CHR$(34) + vl_id$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "elementen" + CHR$(34) + ":["
    i% = 0
    WHILE i% < n%
        IF i% > 0 THEN
            out$ = out$ + ","
        END IF
        id$ = POSTGRES_GET_BY_NAME$(rid%, i%, "id")
        mat$ = POSTGRES_GET_BY_NAME$(rid%, i%, "material_id")
        omschr$ = SUBSTITUTE$(SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "omschrijving"), CHR$(34), ""), CHR$(10), " ")
        area$ = POSTGRES_GET_BY_NAME$(rid%, i%, "area_m2")
        len$ = POSTGRES_GET_BY_NAME$(rid%, i%, "length_m")
        qv$ = POSTGRES_GET_BY_NAME$(rid%, i%, "qvent")
        sort$ = POSTGRES_GET_BY_NAME$(rid%, i%, "sort_order")
        cat$ = SUBSTITUTE$(SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, i%, "catalog_id"), CHR$(34), ""), CHR$(10), " ")
        out$ = out$ + "{" + CHR$(34) + "element_id" + CHR$(34) + ":" + CHR$(34) + id$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "material_id" + CHR$(34) + ":"
        IF mat$ = "" THEN
            out$ = out$ + "null"
        ELSE
            out$ = out$ + CHR$(34) + mat$ + CHR$(34)
        END IF
        out$ = out$ + "," + CHR$(34) + "catalog_id" + CHR$(34) + ":" + CHR$(34) + cat$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "omschrijving" + CHR$(34) + ":" + CHR$(34) + omschr$ + CHR$(34)
        out$ = out$ + "," + CHR$(34) + "area_m2" + CHR$(34) + ":" + area$
        out$ = out$ + "," + CHR$(34) + "length_m" + CHR$(34) + ":" + len$
        out$ = out$ + "," + CHR$(34) + "qvent" + CHR$(34) + ":" + qv$
        out$ = out$ + "," + CHR$(34) + "sort_order" + CHR$(34) + ":" + sort$ + "}"
        i% = i% + 1
    WEND
    out$ = out$ + "]}"
    RETURN out$
END PROCEDURE

PROCEDURE API_SaveVlakElement(session_token$, vlak_id$, element_id$, material_id$, omschrijving$, area_m2$, length_m$, qvent$, sort_order$) AS STRING
    DIM sql$, rid%, t$, vl_id$, el_id$, mat$, omschr$, area$, len$, qv$, sort$, out$, created$, b_id$, matname$

    IF g_bootstrapped% = 0 OR g_conn% <= 0 THEN
        RETURN "ERROR: call API_Bootstrap first"
    END IF
    IF session_token$ = "" THEN
        RETURN "ERROR: login required"
    END IF
    t$ = SUBSTITUTE$(session_token$, "'", "''")
    sql$ = "SELECT u.username, u.is_engineer::text AS is_engineer "
    sql$ = sql$ + "FROM app_gevelwering.login_session s "
    sql$ = sql$ + "JOIN app_gevelwering.service_user u ON u.id = s.user_id "
    sql$ = sql$ + "WHERE s.token = '" + t$ + "' AND s.revoked_at IS NULL "
    sql$ = sql$ + "AND s.expires_at > now() AND u.is_active = true"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: session invalid or expired — login again"
    END IF
    IF POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "engineer" AND POSTGRES_GET_BY_NAME$(rid%, 0, "username") <> "admin" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "true" AND POSTGRES_GET_BY_NAME$(rid%, 0, "is_engineer") <> "t" THEN
        RETURN "ERROR: engineer access required"
    END IF
    IF vlak_id$ = "" THEN
        RETURN "ERROR: vlak_id is required"
    END IF

    vl_id$ = SUBSTITUTE$(vlak_id$, "'", "''")
    el_id$ = SUBSTITUTE$(element_id$, "'", "''")
    mat$ = SUBSTITUTE$(material_id$, "'", "''")
    omschr$ = SUBSTITUTE$(omschrijving$, "'", "''")
    area$ = SUBSTITUTE$(area_m2$, "'", "''")
    len$ = SUBSTITUTE$(length_m$, "'", "''")
    qv$ = SUBSTITUTE$(qvent$, "'", "''")
    sort$ = SUBSTITUTE$(sort_order$, "'", "''")
    IF area$ = "" THEN
        area$ = "0"
    END IF
    IF len$ = "" THEN
        len$ = "0"
    END IF
    IF qv$ = "" THEN
        qv$ = "0"
    END IF
    IF sort$ = "" THEN
        sort$ = "0"
    END IF

    sql$ = "SELECT building_id::text AS building_id FROM app_gevelwering.vlak WHERE id = '" + vl_id$ + "'::uuid"
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: vlak not found"
    END IF
    b_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "building_id")

    IF omschr$ = "" AND mat$ <> "" THEN
        sql$ = "SELECT COALESCE(name,'') AS name FROM app_gevelwering.material WHERE id = '" + mat$ + "'::uuid"
        rid% = POSTGRES_QUERY(g_conn%, sql$)
        IF POSTGRES_NUM_ROWS(rid%) >= 1 THEN
            omschr$ = SUBSTITUTE$(POSTGRES_GET_BY_NAME$(rid%, 0, "name"), "'", "''")
        END IF
    END IF
    IF omschr$ = "" THEN
        omschr$ = "onbekend"
    END IF

    IF element_id$ = "" THEN
        sql$ = "INSERT INTO app_gevelwering.vlak_element (vlak_id, building_id, material_id, omschrijving, area_m2, length_m, qvent, sort_order) "
        sql$ = sql$ + "VALUES ('" + vl_id$ + "'::uuid, '" + b_id$ + "'::uuid, "
        IF mat$ = "" THEN
            sql$ = sql$ + "NULL"
        ELSE
            sql$ = sql$ + "'" + mat$ + "'::uuid"
        END IF
        sql$ = sql$ + ", '" + omschr$ + "', " + area$ + "::double precision, " + len$ + "::double precision, "
        sql$ = sql$ + qv$ + "::double precision, " + sort$ + "::integer) RETURNING id::text AS id"
        created$ = "true"
    ELSE
        sql$ = "UPDATE app_gevelwering.vlak_element SET material_id = "
        IF mat$ = "" THEN
            sql$ = sql$ + "NULL"
        ELSE
            sql$ = sql$ + "'" + mat$ + "'::uuid"
        END IF
        sql$ = sql$ + ", omschrijving = '" + omschr$ + "', area_m2 = " + area$ + "::double precision, "
        sql$ = sql$ + "length_m = " + len$ + "::double precision, qvent = " + qv$ + "::double precision, "
        sql$ = sql$ + "sort_order = " + sort$ + "::integer, updated_at = now() "
        sql$ = sql$ + "WHERE id = '" + el_id$ + "'::uuid AND vlak_id = '" + vl_id$ + "'::uuid "
        sql$ = sql$ + "RETURNING id::text AS id"
        created$ = "false"
    END IF
    rid% = POSTGRES_QUERY(g_conn%, sql$)
    IF POSTGRES_NUM_ROWS(rid%) < 1 THEN
        RETURN "ERROR: element save failed (check material_id)"
    END IF
    el_id$ = POSTGRES_GET_BY_NAME$(rid%, 0, "id")
    out$ = "{" + CHR$(34) + "ok" + CHR$(34) + ":true," + CHR$(34) + "element_id" + CHR$(34) + ":" + CHR$(34) + el_id$ + CHR$(34)
    out$ = out$ + "," + CHR$(34) + "created" + CHR$(34) + ":" + created$ + "}"
    RETURN out$
END PROCEDURE

